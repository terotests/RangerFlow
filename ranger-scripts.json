{
  "scripts": {
    "rangerflow:artifacts": "bash gallery/rangerflow/web/standalone/build.sh && node gallery/rangerflow/web/standalone/smoke.mjs --all --shots gallery/rangerflow/artifacts && cp gallery/rangerflow/artifacts/scenario_erd.png gallery/rangerflow/artifacts/01_schema_editor_webgl.png",
    "rangerflow:bench": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --bench",
    "rangerflow:build": "node dist/rgrc.js -es6 ./gallery/rangerflow/demo/rangerflow_demo.rgr -d=./gallery/rangerflow/bin -o=rangerflow_demo.js -nodecli",
    "rangerflow:d2": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --d2",
    "rangerflow:d2:dump": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/D2ParityDump.rgr -d=./gallery/rangerflow/bin -o=D2ParityDump.js -nodecli && node ./gallery/rangerflow/bin/D2ParityDump.js gallery/rangerflow/fixtures/d2/*.d2",
    "rangerflow:d2:oracle": "node gallery/rangerflow/harness/oracles/d2_oracle.mjs",
    "rangerflow:d2:parity": "npm run --silent rangerflow:d2:oracle || echo '  (no go toolchain: the D2 oracle could not be built — nothing to compare against)'; npm run --silent rangerflow:d2:dump && node gallery/rangerflow/tools/d2-parity.mjs",
    "rangerflow:demo": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js",
    "rangerflow:demo:web": "bash gallery/rangerflow/web/standalone/build.sh && node gallery/rangerflow/web/standalone/serve.mjs --open",
    "rangerflow:doc:test": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/FlowDocumentTest.rgr -d=./gallery/rangerflow/bin -o=FlowDocumentTest.js -nodecli && node ./gallery/rangerflow/bin/FlowDocumentTest.js",
    "rangerflow:drag": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --drag",
    "rangerflow:flowchart": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --flowchart",
    "rangerflow:force": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --force",
    "rangerflow:forge:test": "node --test gallery/rangerflow/forge/test/*.test.mjs",
    "rangerflow:graphviz": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --graphviz",
    "rangerflow:graphviz:bench": "cd gallery/rangerflow/harness && { [ -d node_modules ] || npm install --silent --no-audit --no-fund; } && cd ../../.. && node gallery/rangerflow/tools/graphviz-bench.mjs",
    "rangerflow:graphviz:colors": "cd gallery/rangerflow/harness && { [ -d node_modules ] || npm install --silent --no-audit --no-fund; } && cd ../../.. && node gallery/rangerflow/tools/graphviz-colors.mjs",
    "rangerflow:graphviz:dump": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/DotParityDump.rgr -d=./gallery/rangerflow/bin -o=DotParityDump.js -nodecli && node ./gallery/rangerflow/bin/DotParityDump.js gallery/rangerflow/fixtures/graphviz/*.gv gallery/rangerflow/fixtures/graphviz/bad/*.gv",
    "rangerflow:graphviz:oracle": "cd gallery/rangerflow/harness && { [ -d node_modules ] || npm install --silent --no-audit --no-fund; } && cd ../../.. && node gallery/rangerflow/harness/oracles/graphviz_oracle.mjs",
    "rangerflow:graphviz:parity": "npm run --silent rangerflow:graphviz:oracle || echo '  (no Graphviz: the oracle could not be built — nothing to compare against)'; npm run --silent rangerflow:graphviz:dump && node gallery/rangerflow/tools/graphviz-parity.mjs",
    "rangerflow:look:test": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/FlowLookTest.rgr -d=./gallery/rangerflow/bin -o=FlowLookTest.js -nodecli && node ./gallery/rangerflow/bin/FlowLookTest.js",
    "rangerflow:mermaid": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --mermaid",
    "rangerflow:mermaid:dump": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/MermaidParityDump.rgr -d=./gallery/rangerflow/bin -o=MermaidParityDump.js -nodecli && node ./gallery/rangerflow/bin/MermaidParityDump.js gallery/rangerflow/fixtures/mermaid/*.mmd $(node -e \"const f='gallery/rangerflow/harness/out/mermaid.json';const t=require('fs').existsSync(f)?(JSON.parse(require('fs').readFileSync(f,'utf8')).types||[]):[];process.stdout.write(t.map(x=>'--header='+x.header).join(' '))\")",
    "rangerflow:mermaid:oracle": "cd gallery/rangerflow/harness && { [ -d node_modules ] || npm install --silent --no-audit --no-fund; } && cd ../../.. && node gallery/rangerflow/harness/oracles/mermaid_oracle.mjs",
    "rangerflow:mermaid:parity": "npm run --silent rangerflow:mermaid:oracle || echo '  (no registry: Mermaid could not be installed — nothing to compare against)'; npm run --silent rangerflow:mermaid:dump && node gallery/rangerflow/tools/mermaid-parity.mjs",
    "rangerflow:org": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --org",
    "rangerflow:parity": "npm run --silent rangerflow:parity:oracles || echo '  (no registry: the geometry oracles could not be built — scoring what is measurable)'; npm run --silent rangerflow:parity:dump && node gallery/rangerflow/tools/parity.mjs",
    "rangerflow:parity:dump": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/ParityDump.rgr -d=./gallery/rangerflow/bin -o=ParityDump.js -nodecli && node ./gallery/rangerflow/bin/ParityDump.js",
    "rangerflow:parity:oracles": "cd gallery/rangerflow/harness && { [ -d node_modules ] || npm install --silent --no-audit --no-fund; } && cd ../../.. && node gallery/rangerflow/harness/oracles/reactflow_oracle.mjs && node gallery/rangerflow/harness/oracles/d3_force_oracle.mjs",
    "rangerflow:plantuml": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --plantuml",
    "rangerflow:plantuml:dump": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/PlantUmlParityDump.rgr -d=./gallery/rangerflow/bin -o=PlantUmlParityDump.js -nodecli && node ./gallery/rangerflow/bin/PlantUmlParityDump.js gallery/rangerflow/fixtures/plantuml/*.puml $(node -e \"const f='gallery/rangerflow/harness/out/plantuml.json';const fs=require('fs');const o=fs.existsSync(f)?JSON.parse(fs.readFileSync(f,'utf8')):{};const t=['@startuml','@startmindmap','@startwbs','@startgantt','@startjson','@startyaml','@starthcl','@startsalt','@startwire','@startebnf','@startregex','@startchen','@startboard','@startfiles','@startditaa','@startdot','@startmath','@startlatex','@startcreole','@startchronology'];process.stdout.write(t.map(x=>'--opener='+x).join(' '))\")",
    "rangerflow:plantuml:oracle": "node gallery/rangerflow/harness/oracles/plantuml_oracle.mjs",
    "rangerflow:plantuml:parity": "npm run --silent rangerflow:plantuml:oracle || echo '  (no PlantUML: the oracle could not be built — nothing to compare against)'; npm run --silent rangerflow:plantuml:dump && node gallery/rangerflow/tools/plantuml-parity.mjs",
    "rangerflow:process": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --process",
    "rangerflow:quality": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --quality gallery/rangerflow/fixtures/*.mmd gallery/rangerflow/fixtures/mermaid/*.mmd",
    "rangerflow:quality:test": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/FlowQualityTest.rgr -d=./gallery/rangerflow/bin -o=FlowQualityTest.js -nodecli && node ./gallery/rangerflow/bin/FlowQualityTest.js",
    "rangerflow:rivals": "npm run --silent rangerflow:parity:dump && node gallery/rangerflow/tools/rivals.mjs",
    "rangerflow:sdl": "bash gallery/rangerflow/platform/sdl/build.sh",
    "rangerflow:sdl:run": "bash gallery/rangerflow/platform/sdl/build.sh --run gallery/rangerflow/fixtures/ecommerce.sql",
    "rangerflow:sdl:smoke": "bash gallery/rangerflow/platform/sdl/build.sh && SDL_VIDEODRIVER=dummy ./tmp/rangerflow-sdl/rangerflow_sdl gallery/rangerflow/fixtures/ecommerce.sql 30",
    "rangerflow:test": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/RangerFlowTest.rgr -d=./gallery/rangerflow/bin -o=RangerFlowTest.js -nodecli && node ./gallery/rangerflow/bin/RangerFlowTest.js",
    "rangerflow:uml": "npm run rangerflow:build && node ./gallery/rangerflow/bin/rangerflow_demo.js --uml",
    "rangerflow:web": "bash gallery/rangerflow/web/standalone/build.sh",
    "rangerflow:web:serve": "bash gallery/rangerflow/web/standalone/build.sh && node gallery/rangerflow/web/standalone/serve.mjs",
    "rangerflow:web:test": "bash gallery/rangerflow/web/standalone/build.sh && node gallery/rangerflow/web/standalone/smoke.mjs --all",
    "rangerflow:wrap:test": "node dist/rgrc.js -es6 ./gallery/rangerflow/tests/FlowWrapTest.rgr -d=./gallery/rangerflow/bin -o=FlowWrapTest.js -nodecli && node ./gallery/rangerflow/bin/FlowWrapTest.js"
  }
}
