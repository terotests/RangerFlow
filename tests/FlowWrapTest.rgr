; SPDX-License-Identifier: AGPL-3.0-or-later
; FlowWrap: a long top-to-bottom flow cut into columns.
;   npm run rangerflow:wrap:test
Import "../domains/mermaid/MermaidRender.rgr"
Import "../layout/FlowWrap.rgr"
Import "../domains/graphviz/DotRender.rgr"

class FlowWrapTest {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what)
        }
    }

    sfn chain:string () {
        return ("flowchart TB\n"
            + "  A[Uusi projekti] --> B{Kuka tietää?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n"
            + "  C --> D{README ajan tasalla?}\n  D -->|Ei| E[git log]\n  D -->|Kyllä| F[Kokeillaan ajaa]\n"
            + "  E --> F\n  F --> G{Käynnistyykö?}\n  G -->|Kyllä| H[Miksi tämä toimii?]\n  G -->|Ei| I[Katso erroria]\n"
            + "  I --> J[Google / AI]\n  J --> K[Ahaa]\n  K --> F\n  H --> L[Pieni muutos]\n"
            + "  L --> M{Toimiiko vielä?}\n  M -->|Kyllä| N[LGTM]\n  M -->|Ei| I\n  N --> O[Ymmärrys 34 %]\n")
    }

    ; twelve steps one after another, nothing branching or looping
    sfn straight:string () {
        return "flowchart TB\n  A --> B\n  B --> C\n  C --> D\n  D --> E\n  E --> F\n  F --> G\n  G --> H\n  H --> I\n  I --> J\n  J --> K\n  K --> L\n"
    }

    sfn graphOf:FlowGraph (text:string) {
        def d:MermaidDrawing (MermaidRender.draw(text (FlowStyle.named("default"))))
        return d.graph
    }

    sfn width:double (g:FlowGraph) {
        def x0:double 1000000.0
        def x1:double -1000000.0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.x < x0) { x0 = n.x }
            if ((n.x + n.width) > x1) { x1 = (n.x + n.width) }
            i = (i + 1)
        }
        return (x1 - x0)
    }

    sfn height:double (g:FlowGraph) {
        def y0:double 1000000.0
        def y1:double -1000000.0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.y < y0) { y0 = n.y }
            if ((n.y + n.height) > y1) { y1 = (n.y + n.height) }
            i = (i + 1)
        }
        return (y1 - y0)
    }

    ; how far a ratio is from a target, either way round
    sfn off:double (r:double target:double) {
        def q:double (r / target)
        if (q < 1.0) {
            q = (1.0 / q)
        }
        return q
    }

    sfn overlaps:int (g:FlowGraph) {
        def c:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def a:FlowNode (g.nodeAt(i))
            def j:int (i + 1)
            while (j < (g.nodeCount())) {
                def b:FlowNode (g.nodeAt(j))
                def sepX:boolean (((a.x + a.width) <= b.x) || ((b.x + b.width) <= a.x))
                def sepY:boolean (((a.y + a.height) <= b.y) || ((b.y + b.height) <= a.y))
                if ((! sepX) && (! sepY)) {
                    c = (c + 1)
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return c
    }

    fn run:void () {
        def g:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def w0:double (FlowWrapTest.width(g))
        def h0:double (FlowWrapTest.height(g))
        this.ok((h0 > (w0 * 2.0)) "the chain is laid out tall")
        def wrap (new FlowWrap())
        def did:boolean (wrap.apply(g 1.5 6))
        this.ok(did "a tall chain in a wide space is wrapped")
        this.ok((wrap.columns >= 2) ("into columns: " + (to_string wrap.columns)))
        def w1:double (FlowWrapTest.width(g))
        def h1:double (FlowWrapTest.height(g))
        def before:double (FlowWrapTest.off((w0 / h0) 1.5))
        def after:double (FlowWrapTest.off((w1 / h1) 1.5))
        this.ok((after < before) ("nearer the space's shape: " + (to_string w1) + "x" + (to_string h1)))
        this.ok(((FlowWrapTest.overlaps(g)) == 0) "no two boxes overlap")
        def routed:int 0
        def e:int 0
        while (e < (g.edgeCount())) {
            def ed:FlowEdge (g.edgeAt(e))
            if ((((array_length ed.waypoints) >= 4) && (ed.sourceHandle >= 0)) || ed.hasLaneX) {
                routed = (routed + 1)
            }
            e = (e + 1)
        }
        this.ok((routed == (g.edgeCount())) "every edge is routed again")
        ; the scene still draws, with every node and edge tagged
        def sc:FlowScene (MermaidRender.sceneWrapped((FlowWrapTest.straight()) "default" 0.0 20.0 1.5))
        this.ok(((sc.worldW / sc.worldH) > 0.5) ("the wrapped scene is a block: " + (to_string sc.worldW) + "x" + (to_string sc.worldH)))

        ; a narrow space keeps one column
        def g2:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def narrow (new FlowWrap())
        this.ok((! (narrow.apply(g2 0.3 6))) "a narrow space keeps one column")
        ; a short flow is left alone
        def g3:FlowGraph (FlowWrapTest.graphOf("flowchart TB\n  A --> B\n  B --> C\n"))
        def short (new FlowWrap())
        this.ok((! (short.apply(g3 1.5 6))) "a short flow is not cut")
        ; groups are left alone
        def g4:FlowGraph (FlowWrapTest.graphOf("flowchart TB\n  subgraph S\n  A --> B\n  end\n  B --> C\n  C --> D\n  D --> E\n  E --> F\n  F --> G\n  G --> H\n"))
        def grouped (new FlowWrap())
        this.ok((! (grouped.apply(g4 1.5 6))) "a flow with a group is not cut")

        ; A column ends only at a single link: no loop's way back and no
        ; branch crosses between columns, only the one link from the foot of
        ; a column to the head of the next.
        def g5:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def rowOf5:[int] (FlowWrap.rowsOf(g5))
        def w5 (new FlowWrap())
        def did5:boolean (w5.apply(g5 1.5 6))
        def across:int 0
        def back:int 0
        def k:int 0
        while (k < (g5.edgeCount())) {
            def ed5:FlowEdge (g5.edgeAt(k))
            def ca:int (itemAt w5.colOfRow (itemAt rowOf5 (g5.indexOfNode(ed5.source))))
            def cb:int (itemAt w5.colOfRow (itemAt rowOf5 (g5.indexOfNode(ed5.target))))
            if (ca != cb) {
                across = (across + 1)
            }
            if (cb < ca) {
                back = (back + 1)
            }
            k = (k + 1)
        }
        if did5 {
            this.ok((across == (w5.columns - 1)) ("one link between columns: " + (to_string across) + " for " + (to_string w5.columns) + " columns"))
        }
        this.ok((back == 0) "no edge goes back to an earlier column")
        ; a loop round the whole flow leaves no place to cut
        def g6:FlowGraph (FlowWrapTest.graphOf("flowchart TB\n  A --> B\n  B --> C\n  C --> D\n  D --> E\n  E --> F\n  F --> G\n  G --> H\n  H --> A\n"))
        def loop (new FlowWrap())
        this.ok((! (loop.apply(g6 1.5 6))) "a flow that loops back to its start is not cut")
        this.edgesInside()
    }

    ; Runs between columns go below one column and above the next, and a
    ; loop's way back goes round the side: the drawing's box holds all of
    ; them, so nothing is cut off at its edge.
    fn edgesInside:void () {
        def dot:string ("digraph {\n  rankdir=TB;\n  node [shape=box];\n  UI [label=\"excavator-ui\"];\n"
            + "  MAS [label=\"MachineAppService\"];\n  PUB [label=\"SharePublisher\"];\n  MAN [label=\"Manage\"];\n"
            + "  REC [label=\"ShareReceiver\"];\n  DB [label=\"Project DB\"];\n  UI -> MAS -> PUB -> MAN;\n"
            + "  MAN -> REC -> DB;\n  REC -> MAS [style=dashed, label=\"republish\"];\n}\n")
        def aspects:[double] ([] _:double (2.44 1.78 1.0))
        def a:int 0
        while (a < (array_length aspects)) {
            def sc:FlowScene (DotRender.sceneWrappedStyled(dot (FlowStyle.named("default")) 0.0 20.0 (itemAt aspects a)))
            def outside:int 0
            def paths:int 0
            def i:int 0
            while (i < (array_length sc.items)) {
                def it:SceneItem (itemAt sc.items i)
                if (it.kind == 2) {
                    paths = (paths + 1)
                    def k:int 0
                    while ((k + 1) < (array_length it.pts)) {
                        def px:double (itemAt it.pts k)
                        def py:double (itemAt it.pts (k + 1))
                        if ((((px < -0.5) || (py < -0.5)) || (px > (sc.worldW + 0.5))) || (py > (sc.worldH + 0.5))) {
                            outside = (outside + 1)
                        }
                        k = (k + 2)
                    }
                }
                i = (i + 1)
            }
            def tag:string (to_string (itemAt aspects a))
            this.ok((paths >= 6) ("the edges are drawn at aspect " + tag + ": " + (to_string paths)))
            this.ok((outside == 0) ("every edge point is inside the drawing at aspect " + tag + ": " + (to_string outside) + " outside " + (to_string sc.worldW) + "x" + (to_string sc.worldH)))
            a = (a + 1)
        }
    }

    ; A decision whose one branch goes through a box and whose other skips
    ; it, twice, cut into columns: each skip keeps the lane the layout gave
    ; it beside the box it skips. Routed again from end to end, it went
    ; straight through that box, and the two lines crossed over it.
    fn skipsKeepTheirLanes:void () {
        def text:string ("flowchart TD\n  A([Kahvila]) --> B{Jono?}\n  B -->|lyhyt| D[Tilaa]\n  B -->|pitkä| C[Odota]\n  C --> D\n"
            + "  D --> E{Pulla?}\n  E -->|kyllä| F[Korvapuusti]\n  E -->|ei| H((Nauti))\n  F --> H\n")
        def g:FlowGraph (FlowWrapTest.graphOf(text))
        this.ok(((EdgeOverlap.nodeCrossings(g)) == 0) "laid out, no line goes through a box")
        def wrap (new FlowWrap())
        this.ok((wrap.apply(g 1.9 6)) "the chart is wrapped")
        this.ok((wrap.columns >= 2) ("into columns: " + (to_string wrap.columns)))
        this.ok(((EdgeOverlap.nodeCrossings(g)) == 0) ("wrapped, no line goes through a box: " + (to_string (EdgeOverlap.nodeCrossings(g)))))
        ; the fork stands over the middle of its two ways on
        def b:FlowNode (g.nodeById("B"))
        def c:FlowNode (g.nodeById("C"))
        def d:FlowNode (g.nodeById("D"))
        this.ok(((fabs ((b.centerX()) - (d.centerX()))) < 8.0) "the decision and the box both its ways reach line up")
        this.ok(((c.centerX()) < ((b.centerX()) - 8.0)) "the box one way passes stands to one side")
    }

    ; A left-to-right chain on a wide slide: cut into rows, read left to
    ; right and then on the next row, every box as tall as it was, no line
    ; through a box. One strip of seven was a row of tiny boxes.
    fn rows:void () {
        def text:string ("flowchart LR\n  L[Liidi] --> E[Ensikauppa] --> O[Onboarding] --> S[Säännöllinen asiakas]\n"
            + "  S --> D{Summa ≥ 800?}\n  D -->|Kyllä| A[Avainasiakas]\n  D -->|Ei| K[Kasvuohjelma]\n")
        def g:FlowGraph (FlowWrapTest.graphOf(text))
        this.ok((g.flow == "LR") ("the layout says its direction: " + g.flow))
        def w0:double (FlowWrapTest.width(g))
        def h0:double (FlowWrapTest.height(g))
        def boxH:double (g.nodeById("L")).height
        def wrap (new FlowWrap())
        this.ok((wrap.applyFlow(g 2.9 6)) "a long left-to-right chain on a wide slide is wrapped")
        this.ok((wrap.columns == 2) ("into two rows: " + (to_string wrap.columns)))
        def w1:double (FlowWrapTest.width(g))
        def h1:double (FlowWrapTest.height(g))
        this.ok(((w1 < w0) && (h1 > h0)) ("narrower and taller: " + (to_string w1) + "x" + (to_string h1) + " from " + (to_string w0) + "x" + (to_string h0)))
        def l:FlowNode (g.nodeById("L"))
        def o:FlowNode (g.nodeById("O"))
        def s:FlowNode (g.nodeById("S"))
        def d:FlowNode (g.nodeById("D"))
        this.ok(((fabs ((l.centerY()) - (o.centerY()))) < 1.0) "the first steps are one row")
        this.ok((s.y > (o.y + o.height)) "the next step starts the next row, under it")
        this.ok((s.x < o.x) "…from the left")
        this.ok((((fabs ((s.centerY()) - (d.centerY()))) < 1.0) && (d.x > s.x)) "…and the row goes on to the right")
        this.ok(((fabs (l.height - boxH)) < 0.01) "a box keeps its size")
        this.ok(((FlowWrapTest.overlaps(g)) == 0) "no two boxes overlap")
        this.ok(((EdgeOverlap.nodeCrossings(g)) == 0) ("no line goes through a box: " + (to_string (EdgeOverlap.nodeCrossings(g)))))
        ; a slide's spacing closes the rows up, and still nothing collides
        def gt:FlowGraph (FlowWrapTest.graphOf(text))
        def tight (new FlowWrap())
        tight.spacing = 0.6
        tight.applyFlow(gt 2.9 6)
        def ht:double (FlowWrapTest.height(gt))
        this.ok((ht < (h1 * 0.92)) ("spacing 0.6: the rows closer: " + (to_string ht) + " from " + (to_string h1)))
        this.ok(((FlowWrapTest.overlaps(gt)) == 0) "…no two boxes overlap")
        this.ok(((EdgeOverlap.nodeCrossings(gt)) == 0) ("…and no line goes through a box: " + (to_string (EdgeOverlap.nodeCrossings(gt)))))
        ; a space as wide as the strip keeps it, and a top-to-bottom flow
        ; still goes into columns
        def g2:FlowGraph (FlowWrapTest.graphOf(text))
        def narrow (new FlowWrap())
        this.ok((! (narrow.applyFlow(g2 12.0 6))) "a space as wide as the strip keeps it")
        def g3:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def tall (new FlowWrap())
        this.ok(((tall.applyFlow(g3 1.5 6)) && (tall.columns >= 2)) "a top-to-bottom chain still goes into columns")
    }

    sfn main:void () {
        def t (new FlowWrapTest())
        t.run()
        t.skipsKeepTheirLanes()
        t.rows()
        print ((to_string t.passes) + " passed, " + (to_string t.fails) + " failed")
    }
}
