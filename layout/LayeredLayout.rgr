; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; LayeredLayout.rgr — a Sugiyama-style layered layout.
; ============================================================================
;
; A force layout is the right answer for an unknown graph and the wrong one for
; a database schema: nobody wants their tables arranged by simulated annealing.
; A schema has direction — a foreign key points from the dependent table to the
; one it depends on — and a layered layout is what makes that direction visible:
;
;        users
;          │
;     ┌────┴────┐
;     ↓         ↓
;   orders   profiles
;     │
;     ↓
; order_items
;
; This is the classic four-phase pipeline, in its honest small form:
;
;   1. break cycles          a DFS; back edges are reversed for layout only
;   2. assign layers         longest path from a source
;   3. order within layers   barycentre sweeps, which is the crossing reduction,
;                            counted and kept at its best, then transpose and
;                            sifting, with restarts while crossings are left —
;                            all within a work budget (`orderBudget`)
;   4. assign coordinates    pack each layer, centre it on its neighbours
;
    ; The seed for (3) is the order the chart was written in. Under TB/BT a
    ; dummy that stands for a reversed (back) edge starts on the LEFT of its
    ; layer — the start of the cross axis. A return path that begins on the
    ; right of the column it is returning up crosses the boxes on the way;
    ; the same path on the left does not. Mermaid's TB default is that
    ; convention: top to bottom, left to right, the feedback on the left.
    ; Under LR/RL the dummies still follow the nodes, which is the picture
    ; a row of states has always been.
;
; Long edges get the real treatment: an edge spanning more than one layer is
; replaced, for the duration of the layout, by a chain of DUMMY vertices — one
; in each layer it crosses. That is Sugiyama's trick and it buys two things at
; once. The dummies take part in the crossing-reduction sweeps, so a long edge
; is ordered against everything else instead of being ignored; and they occupy
; room in their layer, so the real nodes move aside and leave the edge a lane
; to travel down. Afterwards the chain is thrown away and its positions become
; the edge's waypoints — the corners it is drawn through.
;
;   without dummies                 with dummies
;   ┌───┐                           ┌───┐
;   │ a ├──────┬────────┐           │ a ├───┐   ┌───┐
;   └───┘   ┌──┴──┐     │           └───┘   └───┤ · │  ← a dummy holds the lane
;           │  b  │     │                   ┌───┴───┘     open through b's layer
;           └─────┘  ┌──┴──┐        ┌─────┐ │       ┌─────┐
;            ↑ drawn │  c  │        │  b  │ └───────┤  c  │
;              over  └─────┘        └─────┘         └─────┘
; ============================================================================

Import "../core/GraphModel.rgr"
Import "../core/EdgeRouter.rgr"
Import "LayoutMemo.rgr"

class LayeredLayout {
    def graph:FlowGraph (new FlowGraph)
    ; "TB" top-to-bottom, "LR" left-to-right (the schema default).
    def direction:string "LR"
    def layerGap:double 120.0
    def nodeGap:double 32.0
    def sweeps:int 6
    ; The ordering stops early when a sweep finds no crossing at all, and
    ; gives up on sweeps that stop improving: this many in a row that do
    ; not beat the best order so far end the search.
    def patience:int 3
    ; Never more sweeps than this, however much they keep improving.
    def maxSweeps:int 24
    ; How much work the crossing reduction may do, in edge pairs looked at,
    ; before it settles for the best order it has. A layout runs on a
    ; browser's main thread: a graph nobody could read anyway should cost a
    ; frame or two, not freeze the tab.
    def orderBudget:int 3000000
    def orderWork:int 0
    ; What the ordering ended with: crossings between neighbouring layers of
    ; the vertex graph (dummies included), as the seed had them and as left.
    def seedCrossings:int 0
    def finalCrossings:int 0
    ; Off, the ordering is the plain fixed number of barycentre sweeps it
    ; always was, kept for measuring against.
    def keepBest:boolean true
    ; Fresh starts the search may make, from shuffled orders, while
    ; crossings are left and the budget lasts. Seeded, so the same chart is
    ; always the same picture.
    def restarts:int 32
    ; …and what they may spend between them: `restartShare` times what the
    ; first search cost, but never less than `restartFloor`. A small chart
    ; gets all its restarts for next to nothing; a big one with crossings
    ; it cannot lose stops after a few, rather than paying for all of them.
    def restartShare:int 3
    def restartFloor:int 40000
    ; Orders already found, by the shape they were found for — see
    ; `LayoutMemo`. Off unless the caller hands over a live one.
    def memo:FlowLayoutMemo (new FlowLayoutMemo)
    ; Whether this run's order came out of the memo.
    def memoHit:boolean false
    def originX:double 0.0
    def originY:double 0.0
    ; The cross-axis room one routed edge takes in a layer it passes through.
    ; Wide enough that the nodes move aside; narrow enough that a diagram with
    ; many long edges does not become mostly whitespace.
    def edgeGap:double 16.0
    ; The corner radius the routed edges are drawn with.
    def bendRadius:double 5.0
    ; Off, this is a plain layered layout: long edges are neither ordered
    ; against anything nor given room, and they are drawn straight through
    ; whatever stands between their ends. It exists so the difference can be
    ; measured rather than asserted — see `testLongEdgeRouting`.
    def useDummies:boolean true
    ; A picture fitted to a page is scaled by its longer side, so a diagram
    ; that is a long strip along its flow is drawn small: five states in a
    ; row across the page are read at half the size the same five would be
    ; down it. With this on, a layout that came out more than `squareRatio`
    ; times longer along the flow than across it closes its layer gaps —
    ; never below `minLayerGap`, which is what the stubs, the corridor's
    ; tracks and any label written along the flow need — until it is that
    ; ratio, or the gaps are at their floor. Off, the gaps are as asked.
    def squareUp:boolean false
    def squareRatio:double 1.5
    def minLayerGap:double 56.0
    ; Packing each layer and centring it on the widest one puts a chain of
    ; five nodes that hangs off the first node of a row in the middle of the
    ; page, under the third. With this on, every vertex is then moved
    ; towards the mean of its neighbours' positions — down the layers, up
    ; them, and down again — as far as its layer's order and the gaps
    ; allow: a child under its parent, a long edge straight, a row centred
    ; over what it feeds. Off, the layers are centred and left there.
    def balance:boolean false
    def balanceSweeps:int 4
    ; What a dummy's wish weighs against a node's. More than a node keeps
    ; long edges straight at the nodes' expense; less lets a chain of nodes
    ; line up and leaves the long edges to bend round it.
    def dummyWeight:double 4.0
    ; In an ordering sweep, a vertex with no neighbour on the side the sweep
    ; looks at has no barycentre. Off, it keeps its position as its key and
    ; is sorted in among the others on that basis — which compares a
    ; position in this layer with positions in the next, and interleaves
    ; the two: a row of four boxes with four long edges passing it ends up
    ; box, line, box, line. On, such vertices step aside — after the ones
    ; with a say, in the order they had — so a chain and the long edges
    ; that follow it stay together, and the boxes that lead nowhere stand
    ; to the side of them — past the long edges, but not past the real
    ; nodes they were written among (see `sortLayer`).
    def unconnectedAside:boolean false
    ; Nodes (by index) that are never to go backwards: each keeps a layer
    ; no earlier than the one before it in this list, unless an edge path
    ; says otherwise. A list of the groups of a chart in the order they
    ; were written keeps the page reading in that order — a group written
    ; fifth never stands above one written third — without stacking groups
    ; that could stand side by side.
    def keepOrder:[int]
    ; The order the cycle breaking tries its starting points in, by node
    ; index; empty for index order. A cycle has no first node of its own —
    ; which of its edges gets reversed, and so which of its nodes ends up
    ; at the top, is decided entirely by where the search starts. Index
    ; order is the right answer only while the indices are the order the
    ; chart was written in; a caller that builds its graph in some other
    ; order — because it wants a particular node placed first WITHIN its
    ; layer, say — says here what the written order was, and a cycle is
    ; broken in the same place either way.
    def cycleRoots:[int]
    ; Where along a node's cross extent an edge attaches, from the node's
    ; middle, per edge index; empty for the middle. A box that stands for
    ; a whole group has its edges at its members, and a chain through such
    ; boxes is straight only when the members line up, not the boxes.
    def edgeOffsetSource:[double]
    def edgeOffsetTarget:[double]
    ; …and, per end, whether the edge may meet the node anywhere along it
    ; rather than at a point: an arrow drawn to a group's frame lands
    ; wherever on the frame's top is nearest, so its line need not bend
    ; to reach the middle.
    def edgeLooseSource:[boolean]
    def edgeLooseTarget:[boolean]

    ; the vertices of each layer: layerVerts[layerStart[l] …]
    def layerStart:[int]
    def layerVerts:[int]
    ; per node
    def layerOf:[int]
    def orderOf:[int]

    ; --- the vertex graph the ordering and placement actually run on ---------
    ; Real nodes first, in graph order, then one dummy per layer per long edge.
    ; `vNode` is the graph node a vertex stands for, or -1 when it stands for a
    ; stretch of an edge; `vEdge` is that edge.
    def vLayer:[int]
    def vOrder:[int]
    def vNode:[int]
    def vEdge:[int]
    def vExtent:[double]
    def vCross:[double]
    def vOutHead:[int]
    def vOutNext:[int]
    def vOutTo:[int]
    def vOutEdge:[int]
    def vInHead:[int]
    def vInNext:[int]
    def vInFrom:[int]
    def vInEdge:[int]
    ; per original edge: the first dummy of its chain (in layer order), and
    ; whether the layering had to reverse it to break a cycle
    def chainHead:[int]
    def edgeReversed:[boolean]
    ; where each layer sits and how deep it is, along the main axis
    def layerMain:[double]
    def layerDepth:[double]
    ; adjacency, after cycle breaking
    def outHead:[int]
    def outNext:[int]
    def outTo:[int]
    def inHead:[int]
    def inNext:[int]
    def inFrom:[int]

    Constructor () {
    }

    sfn of:LayeredLayout (g:FlowGraph) {
        def l (new LayeredLayout)
        l.graph = g
        return l
    }

    fn run:void () {
        graph.reindex()
        this.buildAdjacency()
        this.assignLayers()
        this.buildVertices()
        this.orderVertices()
        this.assignCoordinates()
        if squareUp {
            if (this.closeGaps()) {
                this.assignCoordinates()
            }
        }
    }

    ; The extent of the picture along the flow, and across it.
    fn extentAlong:double () {
        def lc:int (this.layerCount())
        if (lc == 0) {
            return 0.0
        }
        return ((itemAt layerMain (lc - 1)) + (itemAt layerDepth (lc - 1)))
    }

    fn extentAcross:double () {
        def widest:double 0.0
        def v:int 0
        while (v < (this.vertexCount())) {
            def l:int (itemAt vLayer v)
            def far:double ((itemAt vCross v) + ((itemAt vExtent v) * 0.5))
            if (far > widest) {
                widest = far
            }
            v = (v + 1)
        }
        return widest
    }

    ; Narrow the layer gap as far as the ratio asks and the floor allows.
    ; True if it changed, in which case the coordinates have to be assigned
    ; again with the new gap.
    fn closeGaps:boolean () {
        def lc:int (this.layerCount())
        if (lc < 2) {
            return false
        }
        if (layerGap <= minLayerGap) {
            return false
        }
        def along:double (this.extentAlong())
        def across:double (this.extentAcross())
        def want:double (across * squareRatio)
        if (along <= want) {
            return false
        }
        def gaps:double (to_double (lc - 1))
        def narrower:double (layerGap - ((along - want) / gaps))
        def floor:double (this.corridorNeed())
        if (floor < minLayerGap) {
            floor = minLayerGap
        }
        if (narrower < floor) {
            narrower = floor
        }
        if (narrower >= layerGap) {
            return false
        }
        layerGap = narrower
        return true
    }

    ; The gap the busiest corridor needs: two stubs, a margin inside each,
    ; and a track per edge that turns in it — the edges between the two
    ; layers either side, and the long edges that enter or leave a chain
    ; there. Closing a gap below this leaves the corridor pass no room, and
    ; two edges that should have had tracks of their own are drawn on one
    ; line.
    fn corridorNeed:double () {
        def lc:int (this.layerCount())
        def count:[int]
        def i:int 0
        while (i < lc) {
            push count 0
            i = (i + 1)
        }
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            if (e.sourceIndex >= 0) {
                if (e.targetIndex >= 0) {
                    def la:int (itemAt layerOf e.sourceIndex)
                    def lb:int (itemAt layerOf e.targetIndex)
                    def lo:int la
                    def hi:int lb
                    if (lb < la) {
                        lo = lb
                        hi = la
                    }
                    if (hi > lo) {
                        if ((hi - lo) > 1) {
                            set_at count lo ((itemAt count lo) + 1)
                            set_at count (hi - 1) ((itemAt count (hi - 1)) + 1)
                        } {
                            ; Two neighbours near enough in line get a
                            ; straight line from the fan, which turns
                            ; nowhere and needs no track.
                            if ((this.canBeStraight(e)) == false) {
                                set_at count lo ((itemAt count lo) + 1)
                            }
                        }
                    }
                }
            }
            k = (k + 1)
        }
        def busiest:int 0
        def c:int 0
        while (c < lc) {
            if ((itemAt count c) > busiest) {
                busiest = (itemAt count c)
            }
            c = (c + 1)
        }
        if (busiest < 1) {
            busiest = 1
        }
        return (56.0 + ((to_double (busiest - 1)) * 14.0))
    }

    ; Whether the fan could join these two ends with one straight line: the
    ; two nodes' centres across the flow are within the reach of the slots
    ; on the two sides put together — a third of each box out from its
    ; middle, which is the room `EdgeLanes` gives a box's top and bottom.
    fn canBeStraight:boolean (e:FlowEdge) {
        def a:FlowNode (graph.nodeAt(e.sourceIndex))
        def b:FlowNode (graph.nodeAt(e.targetIndex))
        def apart:double (fabs ((a.centerX()) - (b.centerX())))
        def reach:double ((a.width + b.width) * 0.35)
        if (direction != "TB") {
            apart = (fabs ((a.centerY()) - (b.centerY())))
            reach = ((a.height + b.height) * 0.25)
        }
        return (apart <= reach)
    }

    ; The longest label on any edge, in characters — what a gap along the
    ; flow has to hold when labels are written along it.
    fn longestLabel:int () {
        def longest:int 0
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            def len:int (strlen e.label)
            if (len > longest) {
                longest = len
            }
            k = (k + 1)
        }
        return longest
    }

    ; A pair of intrusive linked lists rather than arrays of arrays: one
    ; allocation per edge instead of one per node, and it compiles the same on
    ; every target.
    fn buildAdjacency:void () {
        clear outHead
        clear outNext
        clear outTo
        clear inHead
        clear inNext
        clear inFrom
        def n:int (graph.nodeCount())
        def i:int 0
        while (i < n) {
            push outHead -1
            push inHead -1
            i = (i + 1)
        }
        clear edgeReversed
        def reversed:[boolean] (this.findBackEdges())
        def rr:int 0
        while (rr < (array_length reversed)) {
            push edgeReversed (itemAt reversed rr)
            rr = (rr + 1)
        }
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            if (e.sourceIndex >= 0) {
                if (e.targetIndex >= 0) {
                    def from:int e.sourceIndex
                    def to:int e.targetIndex
                    if (itemAt reversed k) {
                        from = e.targetIndex
                        to = e.sourceIndex
                    }
                    if (from != to) {
                        push outTo to
                        push outNext (itemAt outHead from)
                        set_at outHead from ((array_length outTo) - 1)
                        push inFrom from
                        push inNext (itemAt inHead to)
                        set_at inHead to ((array_length inFrom) - 1)
                    }
                }
            }
            k = (k + 1)
        }
    }

    ; Depth-first search over the raw edges; an edge back to a node still on
    ; the stack is a cycle edge, and layering cannot proceed with it forwards.
    fn findBackEdges:[boolean] () {
        def out:[boolean]
        def m:int (graph.edgeCount())
        def i:int 0
        while (i < m) {
            push out false
            i = (i + 1)
        }
        def n:int (graph.nodeCount())
        def state:[int]
        def j:int 0
        while (j < n) {
            push state 0
            j = (j + 1)
        }
        def order:[int] (this.cycleOrder())
        def s:int 0
        while (s < (array_length order)) {
            def v:int (itemAt order s)
            if ((itemAt state v) == 0) {
                this.dfsMark(v state out)
            }
            s = (s + 1)
        }
        return out
    }

    ; The starting points for that search, in order: what `cycleRoots` asked
    ; for first, then every node it left out, in index order. The list may
    ; therefore be partial, or empty, and no node is ever lost from it.
    fn cycleOrder:[int] () {
        def out:[int]
        def n:int (graph.nodeCount())
        def taken:[boolean]
        def i:int 0
        while (i < n) {
            push taken false
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length cycleRoots)) {
            def v:int (itemAt cycleRoots k)
            if (v >= 0) {
                if (v < n) {
                    if ((itemAt taken v) == false) {
                        set_at taken v true
                        push out v
                    }
                }
            }
            k = (k + 1)
        }
        def j:int 0
        while (j < n) {
            if ((itemAt taken j) == false) {
                push out j
            }
            j = (j + 1)
        }
        return out
    }

    fn dfsMark:void (v:int state:[int] out:[boolean]) {
        set_at state v 1
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            if (e.sourceIndex == v) {
                def t:int e.targetIndex
                if (t >= 0) {
                    def st:int (itemAt state t)
                    if (st == 1) {
                        set_at out k true
                    }
                    if (st == 0) {
                        this.dfsMark(t state out)
                    }
                }
            }
            k = (k + 1)
        }
        set_at state v 2
    }

    ; Longest path from a source. Iterating to a fixed point rather than a
    ; topological sort: the graph is already acyclic here, and the loop count
    ; is bounded by the node count, which is what makes it terminate on the
    ; graphs a schema produces.
    fn assignLayers:void () {
        clear layerOf
        def n:int (graph.nodeCount())
        def i:int 0
        while (i < n) {
            push layerOf 0
            i = (i + 1)
        }
        this.relaxLayers()
        if ((array_length keepOrder) < 2) {
            return
        }
        ; The written order, as far as the edges allow: a node lifted to the
        ; layer of the one written before it takes what hangs off it along,
        ; and the two are settled together. Never against an edge path: a
        ; node the earlier one can be reached from stays where the path put
        ; it.
        def guard:int 0
        def again:boolean true
        while again {
            again = false
            guard = (guard + 1)
            if (guard > (n + 2)) {
                return
            }
            def k:int 1
            while (k < (array_length keepOrder)) {
                def a:int (itemAt keepOrder (k - 1))
                def b:int (itemAt keepOrder k)
                if (a >= 0) {
                    if (b >= 0) {
                        if (a < n) {
                            if (b < n) {
                                if ((itemAt layerOf b) < (itemAt layerOf a)) {
                                    if ((this.reaches(b a)) == false) {
                                        set_at layerOf b (itemAt layerOf a)
                                        again = true
                                    }
                                }
                            }
                        }
                    }
                }
                k = (k + 1)
            }
            if again {
                this.relaxLayers()
            }
        }
    }

    ; Whether `to` is downstream of `from` along the edges as layered.
    fn reaches:boolean (from:int to:int) {
        def n:int (graph.nodeCount())
        def seen:[boolean]
        def i:int 0
        while (i < n) {
            push seen false
            i = (i + 1)
        }
        def stack:[int]
        push stack from
        set_at seen from true
        while ((array_length stack) > 0) {
            def v:int (last stack)
            removeLast stack
            if (v == to) {
                return true
            }
            def at:int (itemAt outHead v)
            while (at >= 0) {
                def w:int (itemAt outTo at)
                if ((itemAt seen w) == false) {
                    set_at seen w true
                    push stack w
                }
                at = (itemAt outNext at)
            }
        }
        return false
    }

    ; Longest path from a source, by relaxation. Only ever raises a layer,
    ; so it can be run again after something else has.
    fn relaxLayers:void () {
        def n:int (graph.nodeCount())
        def changed:boolean true
        def guard:int 0
        while (changed) {
            changed = false
            guard = (guard + 1)
            if (guard > (n + 2)) {
                return
            }
            def v:int 0
            while (v < n) {
                def cur:int (itemAt layerOf v)
                def at:int (itemAt outHead v)
                while (at >= 0) {
                    def to:int (itemAt outTo at)
                    def want:int (cur + 1)
                    if ((itemAt layerOf to) < want) {
                        set_at layerOf to want
                        changed = true
                    }
                    at = (itemAt outNext at)
                }
                v = (v + 1)
            }
        }
    }

    fn layerCount:int () {
        def m:int 0
        def i:int 0
        while (i < (array_length layerOf)) {
            def l:int (itemAt layerOf i)
            if (l > m) {
                m = l
            }
            i = (i + 1)
        }
        return (m + 1)
    }

    ; ------------------------------------------------------- the vertices --
    ; Real nodes, then a dummy for every layer a long edge crosses. The chain
    ; replaces the edge for the rest of the layout: the ordering sweeps see it,
    ; and the packing gives it room.
    fn buildVertices:void () {
        clear vLayer
        clear vOrder
        clear vNode
        clear vEdge
        clear vExtent
        clear vCross
        clear vOutHead
        clear vOutNext
        clear vOutTo
        clear vOutEdge
        clear vInHead
        clear vInNext
        clear vInFrom
        clear vInEdge
        clear chainHead
        def n:int (graph.nodeCount())
        def i:int 0
        while (i < n) {
            def nd:FlowNode (graph.nodeAt(i))
            def cross:double nd.height
            if (direction == "TB") {
                cross = nd.width
            }
            this.pushVertex((itemAt layerOf i) i -1 cross)
            i = (i + 1)
        }
        def k:int 0
        while (k < (graph.edgeCount())) {
            push chainHead -1
            k = (k + 1)
        }
        def e:int 0
        while (e < (graph.edgeCount())) {
            def ed:FlowEdge (graph.edgeAt(e))
            def ok:boolean true
            if (ed.sourceIndex < 0) { ok = false }
            if (ed.targetIndex < 0) { ok = false }
            if ok {
                def from:int ed.sourceIndex
                def to:int ed.targetIndex
                if (itemAt edgeReversed e) {
                    from = ed.targetIndex
                    to = ed.sourceIndex
                }
                if (from != to) {
                    def lf:int (itemAt layerOf from)
                    def lt:int (itemAt layerOf to)
                    def span:int (lt - lf)
                    if (useDummies == false) {
                        span = 1
                    }
                    if (span <= 1) {
                        this.linkVertices(from to e)
                    } {
                        ; one dummy per layer strictly between the two ends
                        def prev:int from
                        def first:int -1
                        def l:int (lf + 1)
                        while (l < lt) {
                            def dummyExt:double edgeGap
                            ; A return path is a column of its own, not a
                            ; sixteen-pixel sliver beside the box it is
                            ; avoiding. Wide enough that the node sitting
                            ; on it stands clear of the column it is
                            ; returning up; not so wide that a dummy in a
                            ; busy layer (a state machine's return past
                            ; the next state) pushes the chain apart.
                            if (this.verticalFlow()) {
                                if (itemAt edgeReversed e) {
                                    def fromN:FlowNode (graph.nodeAt(from))
                                    def toN:FlowNode (graph.nodeAt(to))
                                    def aw:double fromN.width
                                    def bw:double toN.width
                                    if (bw < aw) {
                                        aw = bw
                                    }
                                    def need:double (aw * 0.3)
                                    if (need < 32.0) {
                                        need = 32.0
                                    }
                                    if (need > 48.0) {
                                        need = 48.0
                                    }
                                    if (need > dummyExt) {
                                        dummyExt = need
                                    }
                                }
                            }
                            def dv:int (this.pushVertex(l -1 e dummyExt))
                            if (first < 0) {
                                first = dv
                            }
                            this.linkVertices(prev dv e)
                            prev = dv
                            l = (l + 1)
                        }
                        this.linkVertices(prev to e)
                        set_at chainHead e first
                    }
                }
            }
            e = (e + 1)
        }
    }

    fn pushVertex:int (layer:int nodeIdx:int edgeIdx:int extent:double) {
        push vLayer layer
        push vOrder 0
        push vNode nodeIdx
        push vEdge edgeIdx
        push vExtent extent
        push vCross 0.0
        push vOutHead -1
        push vInHead -1
        return ((array_length vLayer) - 1)
    }

    fn linkVertices:void (from:int to:int edge:int) {
        push vOutEdge edge
        push vInEdge edge
        push vOutTo to
        push vOutNext (itemAt vOutHead from)
        set_at vOutHead from ((array_length vOutTo) - 1)
        push vInFrom from
        push vInNext (itemAt vInHead to)
        set_at vInHead to ((array_length vInFrom) - 1)
    }

    fn vertexCount:int () {
        return (array_length vLayer)
    }

    ; A dummy that holds a reversed edge's lane through this layer. Those are
    ; the return paths: they start on the left so they do not cross the column
    ; they are returning up. Forward long-edge dummies stay on the right of
    ; the nodes, which is where they have always been.
    fn reversedDummy:boolean (v:int) {
        if ((itemAt vNode v) >= 0) {
            return false
        }
        def e:int (itemAt vEdge v)
        return (this.reversedEdge(e))
    }

    fn reversedEdge:boolean (e:int) {
        if (e < 0) {
            return false
        }
        if (e >= (array_length edgeReversed)) {
            return false
        }
        return (itemAt edgeReversed e)
    }

    ; A TB/BT column: the return belongs on the left. An LR/RL row keeps
    ; dummies after the nodes — a return on the top of a row of states is
    ; a different picture, and not what this change is for.
    fn verticalFlow:boolean () {
        if (direction == "LR") {
            return false
        }
        if (direction == "RL") {
            return false
        }
        return true
    }

    ; Per layer, under TB/BT: return-path dummies, then real nodes in graph
    ; order, then the dummies of forward long edges. Barycentre keeps this
    ; where the keys tie, which they do for a cycle A→B→C→A: B and the dummy
    ; of the reversed C→A both look at the same neighbour, so the dummy stays
    ; left and C stands under it rather than to the right of B. Under LR/RL
    ; the nodes come first, then every dummy, as they always did.
    fn seedVertexOrder:void () {
        def vertical:boolean (this.verticalFlow())
        def lc:int (this.layerCount())
        def total:int (this.vertexCount())
        def l:int 0
        while (l < lc) {
            def backs:[int]
            def nodes:[int]
            def rest:[int]
            def v:int 0
            while (v < total) {
                if ((itemAt vLayer v) == l) {
                    if ((itemAt vNode v) >= 0) {
                        push nodes v
                    } {
                        if vertical {
                            if (this.reversedDummy(v)) {
                                push backs v
                            } {
                                push rest v
                            }
                        } {
                            push rest v
                        }
                    }
                }
                v = (v + 1)
            }
            def order:int 0
            if vertical {
                def a:int 0
                while (a < (array_length backs)) {
                    set_at vOrder (itemAt backs a) order
                    order = (order + 1)
                    a = (a + 1)
                }
            }
            def b:int 0
            while (b < (array_length nodes)) {
                set_at vOrder (itemAt nodes b) order
                order = (order + 1)
                b = (b + 1)
            }
            def c:int 0
            while (c < (array_length rest)) {
                set_at vOrder (itemAt rest c) order
                order = (order + 1)
                c = (c + 1)
            }
            l = (l + 1)
        }
    }

    ; Barycentre ordering, now over the vertices rather than the nodes: sort
    ; each layer by the mean position of what it is joined to in the layer
    ; before (then after, alternating). It is the cheapest crossing reduction
    ; that actually works, and it is what dagre and Graphviz both start from.
    ; Running it over the dummies too is the whole point of having them — a
    ; long edge is now something the sweep can move out of the way.
    fn orderVertices:void () {
        this.seedVertexOrder()
        this.buildLayerLists()
        def lc:int (this.layerCount())
        orderWork = 0
        ; A layout whose lines meet boxes at points along them — the boxes
        ; that stand for groups — is not judged by counting crossings
        ; between boxes: a line attaches at the member it goes to, and which
        ; order of boxes draws without crossings depends on where those
        ; members are, which the count cannot see. Ranked by it, a chart of
        ; eight groups chose an order with "no" crossings that drew four,
        ; over one with "four" that drew none. Those keep the fixed sweeps.
        def judged:boolean keepBest
        if ((array_length edgeOffsetSource) > 0) {
            judged = false
        }
        if (judged == false) {
            def sweep:int 0
            while (sweep < sweeps) {
                def down:boolean ((sweep % 2) == 0)
                def l2:int 0
                while (l2 < lc) {
                    this.sortLayer(l2 down)
                    l2 = (l2 + 1)
                }
                sweep = (sweep + 1)
            }
            seedCrossings = -1
            finalCrossings = (this.countCrossings())
        } {
            memoHit = false
            def sig:string ""
            if memo.active {
                sig = (this.shapeSignature())
                def kept:[int] (memo.lookup(sig))
                if ((array_length kept) == (this.vertexCount())) {
                    this.restoreOrder(kept)
                    seedCrossings = -1
                    finalCrossings = (memo.crossingsOf(sig))
                    memoHit = true
                }
            }
            if (memoHit == false) {
                this.reduceCrossings()
                if memo.active {
                    memo.remember(sig vOrder finalCrossings)
                }
            }
        }
        this.deriveNodeOrder()
    }

    ; What the order depends on and nothing else: the direction, each
    ; vertex's layer and what it stands for, and which vertices are joined.
    ; Sizes and labels are left out on purpose — a label edit keeps the
    ; shape, and with it the order.
    fn shapeSignature:string () {
        def out:string direction
        out = (out + "|" + (to_string (this.seedFlags())))
        def v:int 0
        while (v < (this.vertexCount())) {
            def ni:int (itemAt vNode v)
            out = (out + ";" + (to_string (itemAt vLayer v)) + ":")
            if (ni >= 0) {
                out = (out + (graph.nodeAt(ni)).id)
            } {
                out = (out + "~" + (to_string (itemAt vEdge v)))
            }
            def at:int (itemAt vOutHead v)
            while (at >= 0) {
                out = (out + ">" + (to_string (itemAt vOutTo at)))
                at = (itemAt vOutNext at)
            }
            out = (out + "@" + (to_string (itemAt vOrder v)))
            v = (v + 1)
        }
        return out
    }

    ; The switches that change what the search does with a shape.
    fn seedFlags:int () {
        def f:int 0
        if unconnectedAside {
            f = (f + 1)
        }
        if useDummies {
            f = (f + 2)
        }
        return ((f * 1000) + sweeps)
    }

    ; The crossing reduction, judged. The barycentre sweeps run as they
    ; always did — they are what puts a long edge's dummies beside the
    ; nodes they run past, which is what keeps a chain straight — but every
    ; sweep is counted and the order kept is the last one with the fewest
    ; crossings, not merely the last one. While they keep improving they
    ; get more sweeps, up to `maxSweeps`; once `patience` sweeps in a row
    ; find nothing better, they stop.
    ;
    ; The seed — the order the chart was written in — is taken instead only
    ; when it has strictly fewer crossings than anything the sweeps found.
    ;
    ; After that, adjacent vertices are swapped where that removes a
    ; crossing (Gansner et al.'s transpose): the barycentre puts two
    ; vertices with the same key in an arbitrary order, and a swap is what
    ; settles a tie the right way round. Only a strict improvement swaps.
    fn reduceCrossings:void () {
        def seedOrder:[int] (this.copyOrder())
        seedCrossings = (this.countCrossings())
        def bestCount:int (this.searchFromHere(seedCrossings))
        def best:[int] (this.copyOrder())
        ; A local search ends where it ends: a drawing that needs two layers
        ; turned round at once is out of reach of any one move. Started
        ; again from elsewhere, it often is not — so while crossings are
        ; left and the budget lasts, try again from the order a depth-first
        ; walk down the chart meets the vertices in, and from the written
        ; order mirrored. A restart replaces the result only when it is
        ; strictly better, so on a tie the written order wins.
        def tries:int (2 + restarts)
        def fruitless:int 0
        def firstWork:int orderWork
        def allowance:int (firstWork * restartShare)
        if (allowance < restartFloor) {
            allowance = restartFloor
        }
        def rng:int 7919
        def start:int 0
        while ((bestCount > 0) && (start < tries)) {
            if (orderWork > orderBudget) {
                start = tries
            } {
                if (start == 0) {
                    this.seedDepthFirst()
                }
                if (start == 1) {
                    this.restoreOrder(seedOrder)
                    this.mirrorOrder()
                }
                if (start >= 2) {
                    rng = (this.shuffleOrder(rng))
                }
                def again:int (this.searchFromHere((this.countCrossings())))
                if (again < bestCount) {
                    bestCount = again
                    best = (this.copyOrder())
                    fruitless = 0
                } {
                    fruitless = (fruitless + 1)
                }
                start = (start + 1)
                if ((orderWork - firstWork) > allowance) {
                    start = tries
                }
            }
        }
        this.restoreOrder(best)
        finalCrossings = bestCount
    }

    ; Sweeps and local moves from the order the vertices have now; leaves
    ; the best order found in place and returns its crossings.
    fn searchFromHere:int (startCount:int) {
        def lc:int (this.layerCount())
        def seedOrder:[int] (this.copyOrder())
        def seedCount:int startCount
        def best:[int] seedOrder
        def bestCount:int -1
        def sweep:int 0
        def idle:int 0
        def limit:int maxSweeps
        if (sweeps > limit) {
            limit = sweeps
        }
        while (sweep < limit) {
            def down:boolean ((sweep % 2) == 0)
            def l2:int 0
            while (l2 < lc) {
                this.sortLayer(l2 down)
                l2 = (l2 + 1)
            }
            def now:int (this.countCrossings())
            if ((bestCount < 0) || (now < bestCount)) {
                bestCount = now
                best = (this.copyOrder())
                idle = 0
            } {
                if (now == bestCount) {
                    best = (this.copyOrder())
                }
                idle = (idle + 1)
            }
            sweep = (sweep + 1)
            if (sweep >= sweeps) {
                if (bestCount == 0) {
                    sweep = limit
                }
                if (idle >= patience) {
                    sweep = limit
                }
            }
            if (orderWork > orderBudget) {
                sweep = limit
            }
        }
        if ((bestCount < 0) || (seedCount < bestCount)) {
            best = seedOrder
            bestCount = seedCount
        }
        this.restoreOrder(best)
        ; Then the local moves, in turns, for as long as a turn helps.
        def round:int 0
        while ((bestCount > 0) && (round < 4)) {
            this.transpose()
            this.sift()
            def after:int (this.countCrossings())
            if (after < bestCount) {
                bestCount = after
                best = (this.copyOrder())
                round = (round + 1)
            } {
                this.restoreOrder(best)
                round = 4
            }
            if (orderWork > orderBudget) {
                round = 4
            }
        }
        return bestCount
    }

    ; Every layer in a shuffled order (Park–Miller, so every target shuffles
    ; alike). Returns the generator's next state.
    fn shuffleOrder:int (state:int) {
        def st:int state
        def lc:int (this.layerCount())
        def l:int 0
        while (l < lc) {
            def seq:[int] (this.layerInOrder(l))
            def i:int ((array_length seq) - 1)
            while (i > 0) {
                st = ((st * 16807) % 2147483647)
                def j:int (st % (i + 1))
                def t:int (itemAt seq i)
                set_at seq i (itemAt seq j)
                set_at seq j t
                i = (i - 1)
            }
            def z:int 0
            while (z < (array_length seq)) {
                set_at vOrder (itemAt seq z) z
                z = (z + 1)
            }
            l = (l + 1)
        }
        return st
    }

    ; Every layer read the other way round.
    fn mirrorOrder:void () {
        def lc:int (this.layerCount())
        def l:int 0
        while (l < lc) {
            def size:int ((itemAt layerStart (l + 1)) - (itemAt layerStart l))
            def i:int (itemAt layerStart l)
            while (i < (itemAt layerStart (l + 1))) {
                def v:int (itemAt layerVerts i)
                set_at vOrder v ((size - 1) - (itemAt vOrder v))
                i = (i + 1)
            }
            l = (l + 1)
        }
    }

    ; The order a depth-first walk meets the vertices in, layer by layer:
    ; from each vertex of the top layer in turn (in the order it has), down
    ; its edges in the order they were written. A subtree is kept together,
    ; which is the order a tree-like chart wants and one the barycentre
    ; sweeps do not always find from a shuffled start.
    fn seedDepthFirst:void () {
        def lc:int (this.layerCount())
        def n:int (this.vertexCount())
        def next:[int]
        def l:int 0
        while (l < lc) {
            push next 0
            l = (l + 1)
        }
        def seen:[boolean]
        def v:int 0
        while (v < n) {
            push seen false
            v = (v + 1)
        }
        def roots:[int]
        def layer:int 0
        while (layer < lc) {
            def inLayer:[int] (this.layerInOrder(layer))
            def r:int 0
            while (r < (array_length inLayer)) {
                push roots (itemAt inLayer r)
                r = (r + 1)
            }
            layer = (layer + 1)
        }
        def stack:[int]
        def ri:int 0
        while (ri < (array_length roots)) {
            def root:int (itemAt roots ri)
            if ((itemAt seen root) == false) {
                push stack root
                while ((array_length stack) > 0) {
                    def top:int (itemAt stack ((array_length stack) - 1))
                    removeLast stack
                    if ((itemAt seen top) == false) {
                        set_at seen top true
                        def tl:int (itemAt vLayer top)
                        set_at vOrder top (itemAt next tl)
                        set_at next tl ((itemAt next tl) + 1)
                        ; the children pushed last-written first, so the
                        ; first-written is walked first
                        def kids:[int]
                        def at:int (itemAt vOutHead top)
                        while (at >= 0) {
                            push kids (itemAt vOutTo at)
                            at = (itemAt vOutNext at)
                        }
                        def kk:int 0
                        while (kk < (array_length kids)) {
                            def kid:int (itemAt kids kk)
                            if ((itemAt seen kid) == false) {
                                push stack kid
                            }
                            kk = (kk + 1)
                        }
                    }
                }
            }
            ri = (ri + 1)
        }
    }

    fn copyOrder:[int] () {
        def out:[int]
        def i:int 0
        while (i < (array_length vOrder)) {
            push out (itemAt vOrder i)
            i = (i + 1)
        }
        return out
    }

    fn restoreOrder:void (saved:[int]) {
        def i:int 0
        while (i < (array_length saved)) {
            set_at vOrder i (itemAt saved i)
            i = (i + 1)
        }
    }

    ; Which vertices stand in each layer. The membership never changes while
    ; the ordering runs, so it is worked out once rather than by walking
    ; every vertex for every layer of every sweep.
    fn buildLayerLists:void () {
        clear layerStart
        clear layerVerts
        def lc:int (this.layerCount())
        def n:int (this.vertexCount())
        def counts:[int]
        def i:int 0
        while (i <= lc) {
            push counts 0
            i = (i + 1)
        }
        def v:int 0
        while (v < n) {
            def l:int (itemAt vLayer v)
            set_at counts l ((itemAt counts l) + 1)
            v = (v + 1)
        }
        def acc:int 0
        def k:int 0
        while (k <= lc) {
            push layerStart acc
            if (k < lc) {
                acc = (acc + (itemAt counts k))
            }
            k = (k + 1)
        }
        def fill:[int]
        def j:int 0
        while (j < n) {
            push layerVerts -1
            j = (j + 1)
        }
        def f:int 0
        while (f < lc) {
            push fill (itemAt layerStart f)
            f = (f + 1)
        }
        def u:int 0
        while (u < n) {
            def lu:int (itemAt vLayer u)
            set_at layerVerts (itemAt fill lu) u
            set_at fill lu ((itemAt fill lu) + 1)
            u = (u + 1)
        }
    }

    ; A layer's vertices, by their current order.
    fn layerInOrder:[int] (layer:int) {
        def raw:[int]
        def out:[int]
        def from:int (itemAt layerStart layer)
        def end:int (itemAt layerStart (layer + 1))
        def size:int (end - from)
        def i:int from
        while (i < end) {
            push raw (itemAt layerVerts i)
            push out -1
            i = (i + 1)
        }
        ; the orders in a layer are 0 … size-1, so each vertex has a slot;
        ; anything else falls back to sorting
        def clean:boolean true
        def k:int 0
        while (k < size) {
            def v:int (itemAt raw k)
            def o:int (itemAt vOrder v)
            if ((o < 0) || (o >= size)) {
                clean = false
                k = size
            } {
                if ((itemAt out o) >= 0) {
                    clean = false
                    k = size
                } {
                    set_at out o v
                    k = (k + 1)
                }
            }
        }
        if clean {
            return out
        }
        return (this.byOrder(raw))
    }

    ; Crossings between every pair of neighbouring layers: for each layer,
    ; its edges to the next sorted by where they start, and the inversions
    ; among where they end counted with a Fenwick tree (Barth, Jünger and
    ; Mutzel's accumulator) — E log V rather than E squared.
    fn countCrossings:int () {
        def lc:int (this.layerCount())
        def total:int 0
        def l:int 0
        while (l < (lc - 1)) {
            total = (total + (this.crossingsBelow(l)))
            l = (l + 1)
        }
        return total
    }

    fn crossingsBelow:int (layer:int) {
        def upper:[int] (this.layerInOrder(layer))
        def size:int ((itemAt layerStart (layer + 2)) - (itemAt layerStart (layer + 1)))
        if (size < 2) {
            return 0
        }
        ; the ends, in the order of the upper vertices and, for one upper
        ; vertex, of the lower ones
        def ends:[int]
        def i:int 0
        while (i < (array_length upper)) {
            def u:int (itemAt upper i)
            def from:int (array_length ends)
            def at:int (itemAt vOutHead u)
            while (at >= 0) {
                def w:int (itemAt vOutTo at)
                if ((itemAt vLayer w) == (layer + 1)) {
                    push ends (itemAt vOrder w)
                }
                at = (itemAt vOutNext at)
            }
            ; insertion sort of this vertex's own ends: a handful
            def a:int (from + 1)
            while (a < (array_length ends)) {
                def key:int (itemAt ends a)
                def b:int (a - 1)
                while (b >= from) {
                    if ((itemAt ends b) > key) {
                        set_at ends (b + 1) (itemAt ends b)
                        b = (b - 1)
                    } {
                        break
                    }
                }
                set_at ends (b + 1) key
                a = (a + 1)
            }
            i = (i + 1)
        }
        def m:int (array_length ends)
        orderWork = (orderWork + m)
        if (m < 2) {
            return 0
        }
        ; Fenwick tree over the lower layer's positions; walking the ends
        ; backwards, each counts the ends already seen that land left of it
        def tree:[int]
        def t:int 0
        while (t <= size) {
            push tree 0
            t = (t + 1)
        }
        def crossings:int 0
        def j:int (m - 1)
        while (j >= 0) {
            def pos:int (itemAt ends j)
            ; how many seen so far are strictly smaller than pos
            def q:int pos
            while (q > 0) {
                crossings = (crossings + (itemAt tree q))
                q = (q - (bit_and q (0 - q)))
            }
            def r:int (pos + 1)
            while (r <= size) {
                set_at tree r ((itemAt tree r) + 1)
                r = (r + (bit_and r (0 - r)))
            }
            j = (j - 1)
        }
        return crossings
    }

    ; Crossings between the edges of u and the edges of w, u standing left
    ; of w, towards one neighbouring layer.
    fn pairCrossings:int (u:int w:int useIncoming:boolean) {
        def count:int 0
        def au:int -1
        if useIncoming {
            au = (itemAt vInHead u)
        } {
            au = (itemAt vOutHead u)
        }
        while (au >= 0) {
            def ou:int 0
            if useIncoming {
                ou = (itemAt vOrder (itemAt vInFrom au))
                au = (itemAt vInNext au)
            } {
                ou = (itemAt vOrder (itemAt vOutTo au))
                au = (itemAt vOutNext au)
            }
            def aw:int -1
            if useIncoming {
                aw = (itemAt vInHead w)
            } {
                aw = (itemAt vOutHead w)
            }
            while (aw >= 0) {
                def ow:int 0
                if useIncoming {
                    ow = (itemAt vOrder (itemAt vInFrom aw))
                    aw = (itemAt vInNext aw)
                } {
                    ow = (itemAt vOrder (itemAt vOutTo aw))
                    aw = (itemAt vOutNext aw)
                }
                if (ou > ow) {
                    count = (count + 1)
                }
                orderWork = (orderWork + 1)
            }
        }
        return count
    }

    ; Swap neighbours in a layer wherever that removes crossings, layer by
    ; layer, until a pass changes nothing or the budget is spent. Only a
    ; strict improvement swaps, so equal pairs keep the order they had.
    fn transpose:void () {
        def lc:int (this.layerCount())
        def improved:boolean true
        def pass:int 0
        while improved {
            improved = false
            def l:int 0
            while (l < lc) {
                def seq:[int] (this.layerInOrder(l))
                def i:int 0
                while (i < ((array_length seq) - 1)) {
                    def u:int (itemAt seq i)
                    def w:int (itemAt seq (i + 1))
                    def before:int ((this.pairCrossings(u w true)) + (this.pairCrossings(u w false)))
                    def after:int ((this.pairCrossings(w u true)) + (this.pairCrossings(w u false)))
                    if (after < before) {
                        def ou:int (itemAt vOrder u)
                        set_at vOrder u (itemAt vOrder w)
                        set_at vOrder w ou
                        set_at seq i w
                        set_at seq (i + 1) u
                        improved = true
                    }
                    i = (i + 1)
                }
                l = (l + 1)
            }
            pass = (pass + 1)
            if (pass >= 12) {
                improved = false
            }
            if (orderWork > orderBudget) {
                improved = false
            }
        }
    }

    ; Sifting (Matuszewski, Schönfeld and Molitor): each vertex in turn is
    ; taken out of its layer and tried in every place in it, and put back
    ; where it crosses least. Transpose only ever swaps neighbours, so a
    ; vertex that belongs three places over has to get there through two
    ; places that are each worse — and never does. Sifting moves it in one
    ; step. The cost of a place is counted from the pairs alone: moving v
    ; past w changes the crossings by c(w,v) − c(v,w).
    fn sift:void () {
        def lc:int (this.layerCount())
        def l:int 0
        while (l < lc) {
            def seq:[int] (this.layerInOrder(l))
            def size:int (array_length seq)
            if (size > 2) {
                def i:int 0
                while (i < size) {
                    if (orderWork > orderBudget) {
                        return
                    }
                    def v:int (itemAt seq i)
                    ; the others, in order, without v
                    def rest:[int]
                    def r:int 0
                    while (r < size) {
                        if ((itemAt seq r) != v) {
                            push rest (itemAt seq r)
                        }
                        r = (r + 1)
                    }
                    ; v before everything, then moved past one at a time;
                    ; `cost` is relative, only the differences matter
                    def cost:int 0
                    def bestCost:int 0
                    def bestAt:int 0
                    def here:int 0
                    def wi:int 0
                    while (wi < (size - 1)) {
                        def w:int (itemAt rest wi)
                        def vw:int ((this.pairCrossings(v w true)) + (this.pairCrossings(v w false)))
                        def wv:int ((this.pairCrossings(w v true)) + (this.pairCrossings(w v false)))
                        cost = (cost + (wv - vw))
                        if (cost < bestCost) {
                            bestCost = cost
                            bestAt = (wi + 1)
                        }
                        ; where v stands now counts as a candidate at its
                        ; own cost, so a tie keeps it where it was
                        if ((wi + 1) == i) {
                            here = cost
                        }
                        wi = (wi + 1)
                    }
                    if (bestCost < here) {
                        def o:int 0
                        def placed:int 0
                        while (o < (size - 1)) {
                            if (o == bestAt) {
                                set_at seq placed v
                                placed = (placed + 1)
                            }
                            set_at seq placed (itemAt rest o)
                            placed = (placed + 1)
                            o = (o + 1)
                        }
                        if (bestAt == (size - 1)) {
                            set_at seq placed v
                        }
                        def z:int 0
                        while (z < size) {
                            set_at vOrder (itemAt seq z) z
                            z = (z + 1)
                        }
                    }
                    i = (i + 1)
                }
            }
            l = (l + 1)
        }
    }

    ; The node-level order is what the tests and any caller read, so it is
    ; derived back out once the vertices have settled.
    fn deriveNodeOrder:void () {
        def lc:int (this.layerCount())
        clear orderOf
        def n:int (graph.nodeCount())
        def z:int 0
        while (z < n) {
            push orderOf 0
            z = (z + 1)
        }
        def seen:[int]
        def c:int 0
        while (c < lc) {
            push seen 0
            c = (c + 1)
        }
        def ranked:[int] (this.vertexRanking())
        def r:int 0
        while (r < (array_length ranked)) {
            def vi:int (itemAt ranked r)
            if (vi >= 0) {
                def ni:int (itemAt vNode vi)
                if (ni >= 0) {
                    def li:int (itemAt vLayer vi)
                    set_at orderOf ni (itemAt seen li)
                    set_at seen li ((itemAt seen li) + 1)
                }
            }
            r = (r + 1)
        }
    }

    fn sortLayer:void (layer:int useIncoming:boolean) {
        def raw:[int]
        def aside:[int]
        def asideAt:[int]
        def everyone:[int] (this.layerInOrder(layer))
        def v0:int 0
        while (v0 < (array_length everyone)) {
            def v:int (itemAt everyone v0)
            def take:boolean true
            if unconnectedAside {
                if ((this.neighbourCount(v useIncoming)) == 0) {
                    push aside v
                    push asideAt v0
                    take = false
                }
            }
            if take {
                push raw v
            }
            v0 = (v0 + 1)
        }
        ; Start from the order the last sweep (or the seed) left, not from
        ; vertex insertion order. Dummies are created after the nodes, so
        ; walking the vertex list would put every return path on the right
        ; of the column it is returning up, and a stable sort on equal
        ; barycentres would keep it there — undoing the seed and any sweep
        ; that had already moved it.
        def members:[int] (this.byOrder(raw))
        def keys:[double]
        def ki:int 0
        while (ki < (array_length members)) {
            push keys (this.barycentre((itemAt members ki) useIncoming))
            ki = (ki + 1)
        }
        def n:int (array_length members)
        ; Insertion sort: a layer is small, and a stable sort keeps vertices
        ; with no neighbours where the previous sweep left them.
        def i:int 1
        while (i < n) {
            def kv:double (itemAt keys i)
            def mv:int (itemAt members i)
            def j:int (i - 1)
            def at:int 0
            def settled:boolean false
            while (j >= 0) {
                if (settled == false) {
                    if ((itemAt keys j) > kv) {
                        set_at keys (j + 1) (itemAt keys j)
                        set_at members (j + 1) (itemAt members j)
                        j = (j - 1)
                    } {
                        ; The insertion point, NOT a signal to keep looping:
                        ; setting `j = -1` here to break lost it, every element
                        ; was inserted at 0, and two vertices in one layer came
                        ; out with the same order — so one of them was never
                        ; placed and drew on top of another.
                        at = (j + 1)
                        settled = true
                        j = -1
                    }
                }
            }
            if (settled == false) {
                at = 0
            }
            set_at keys at kv
            set_at members at mv
            i = (i + 1)
        }
        ; The ones with nothing to say about this side step aside — past the
        ; long edges' dummies, so a chain and the edges that follow it stay
        ; together — but not past the real nodes they were written among:
        ; each goes just before the real node that followed it, or last when
        ; none did. Sending them all to the end of the layer put a leaf
        ; written between two siblings after both: A → B, C, D with only B
        ; and D going on was drawn B D C.
        def anchor:[int]
        def p:int 0
        while (p < (array_length aside)) {
            def found:int -1
            def q:int ((itemAt asideAt p) + 1)
            while (q < (array_length everyone)) {
                def cand:int (itemAt everyone q)
                if ((itemAt vNode cand) >= 0) {
                    if ((this.neighbourCount(cand useIncoming)) > 0) {
                        found = cand
                        q = (array_length everyone)
                    }
                }
                q = (q + 1)
            }
            push anchor found
            p = (p + 1)
        }
        def slot:int 0
        def k:int 0
        while (k < n) {
            def mv2:int (itemAt members k)
            if ((itemAt vNode mv2) >= 0) {
                def x:int 0
                while (x < (array_length aside)) {
                    if ((itemAt anchor x) == mv2) {
                        set_at vOrder (itemAt aside x) slot
                        slot = (slot + 1)
                    }
                    x = (x + 1)
                }
            }
            set_at vOrder mv2 slot
            slot = (slot + 1)
            k = (k + 1)
        }
        def y:int 0
        while (y < (array_length aside)) {
            if ((itemAt anchor y) < 0) {
                set_at vOrder (itemAt aside y) slot
                slot = (slot + 1)
            }
            y = (y + 1)
        }
    }

    fn neighbourCount:int (v:int useIncoming:boolean) {
        def count:int 0
        def at:int -1
        if useIncoming {
            at = (itemAt vInHead v)
        } {
            at = (itemAt vOutHead v)
        }
        while (at >= 0) {
            if useIncoming {
                at = (itemAt vInNext at)
            } {
                at = (itemAt vOutNext at)
            }
            count = (count + 1)
        }
        return count
    }

    ; Vertices by their current order, by insertion: the lists are short.
    fn byOrder:[int] (vs:[int]) {
        def out:[int]
        def i:int 0
        while (i < (array_length vs)) {
            def cand:int (itemAt vs i)
            def key:int (itemAt vOrder cand)
            push out cand
            def j:int ((array_length out) - 1)
            while (j > 0) {
                def prev:int (itemAt out (j - 1))
                if ((itemAt vOrder prev) > key) {
                    set_at out j prev
                    set_at out (j - 1) cand
                    j = (j - 1)
                } {
                    j = 0
                }
            }
            i = (i + 1)
        }
        return out
    }

    fn barycentre:double (v:int useIncoming:boolean) {
        def total:double 0.0
        def count:int 0
        def at:int -1
        if useIncoming {
            at = (itemAt vInHead v)
        } {
            at = (itemAt vOutHead v)
        }
        while (at >= 0) {
            def other:int 0
            if useIncoming {
                other = (itemAt vInFrom at)
                at = (itemAt vInNext at)
            } {
                other = (itemAt vOutTo at)
                at = (itemAt vOutNext at)
            }
            total = (total + (to_double (itemAt vOrder other)))
            count = (count + 1)
        }
        if (count == 0) {
            return (to_double (itemAt vOrder v))
        }
        return (total / (to_double count))
    }

    ; Pack each layer along the cross axis, then centre the layers on each
    ; other so the widest one does not push everything to one side. Dummies are
    ; packed with the real nodes, which is what makes the nodes move aside and
    ; leave a long edge somewhere to go.
    fn assignCoordinates:void () {
        def lc:int (this.layerCount())
        def total:int (this.vertexCount())
        clear layerMain
        clear layerDepth
        def layerExtent:[double]
        def i:int 0
        while (i < lc) {
            push layerExtent 0.0
            push layerDepth 0.0
            push layerMain 0.0
            i = (i + 1)
        }
        def v:int 0
        while (v < total) {
            def l:int (itemAt vLayer v)
            def cross:double (itemAt vExtent v)
            def main:double 0.0
            def ni:int (itemAt vNode v)
            if (ni >= 0) {
                def nd:FlowNode (graph.nodeAt(ni))
                main = nd.width
                if (direction == "TB") {
                    main = nd.height
                }
            }
            def sofar:double (itemAt layerExtent l)
            if (sofar > 0.0) {
                sofar = (sofar + nodeGap)
            }
            set_at layerExtent l (sofar + cross)
            if (main > (itemAt layerDepth l)) {
                set_at layerDepth l main
            }
            v = (v + 1)
        }
        def widest:double 0.0
        def w:int 0
        while (w < lc) {
            def ex:double (itemAt layerExtent w)
            if (ex > widest) {
                widest = ex
            }
            w = (w + 1)
        }
        def cursor:[double]
        def c:int 0
        while (c < lc) {
            def ex2:double (itemAt layerExtent c)
            push cursor ((widest - ex2) * 0.5)
            c = (c + 1)
        }
        def acc:double 0.0
        def m:int 0
        while (m < lc) {
            set_at layerMain m acc
            acc = ((acc + (itemAt layerDepth m)) + layerGap)
            m = (m + 1)
        }
        ; Place in (layer, order) sequence so the packing follows the ordering.
        def sequence:[int] (this.vertexRanking())
        def slot:int 0
        while (slot < (array_length sequence)) {
            def target:int (itemAt sequence slot)
            if (target >= 0) {
                def l2:int (itemAt vLayer target)
                def cross2:double (itemAt vExtent target)
                def at:double (itemAt cursor l2)
                set_at cursor l2 ((at + cross2) + nodeGap)
                ; A vertex's cross position is the CENTRE of the room it took,
                ; which is what a dummy needs — an edge passes through the
                ; middle of its lane, not along the top of it.
                set_at vCross target (at + (cross2 * 0.5))
                def ni2:int (itemAt vNode target)
                if (ni2 >= 0) {
                    def nd2:FlowNode (graph.nodeAt(ni2))
                    def mainAt:double (itemAt layerMain l2)
                    if (direction == "TB") {
                        nd2.x = (originX + at)
                        nd2.y = (originY + mainAt)
                    } {
                        nd2.x = (originX + mainAt)
                        nd2.y = (originY + at)
                    }
                    nd2.syncFromModel()
                    nd2.placed = true
                }
            }
            slot = (slot + 1)
        }
        if balance {
            this.balanceLayers()
        }
        this.faceNeighbours()
    }

    ; ----------------------------------------------------------- balance --
    ; Sugiyama's priority method, in its plain form. A vertex wants to stand
    ; at the mean of its neighbours on the side the sweep came from; a layer
    ; is then placed to satisfy those wishes as nearly as it can without
    ; changing its order or closing a gap below `nodeGap` — the weighted
    ; least-squares fit under those constraints, which is what pooling
    ; adjacent violators solves exactly. A dummy weighs more than a node:
    ; the long edge it stands for is straight when its dummies line up, and
    ; a straight long edge is worth a node standing a little off centre. A
    ; node wants the middle of everything it is joined to on that side,
    ; its own long edges included: a decision with one way into a box and
    ; another past it stands over the two, and they leave it one to each
    ; side — a symmetric fork rather than one line straight down and the
    ; other bent round the box it skips. A reversed long edge is that node's own return path,
    ; not a passer-by, so the node stands toward it. A vertex with nothing
    ; on that side wants to stay where it is, lightly.
    fn balanceLayers:void () {
        def lc:int (this.layerCount())
        if (lc == 0) {
            return
        }
        def seq:[int] (this.vertexRanking())
        def starts:[int]
        def counts:[int]
        def l:int 0
        while (l < lc) {
            push starts 0
            push counts 0
            l = (l + 1)
        }
        def s:int 0
        while (s < (array_length seq)) {
            def v:int (itemAt seq s)
            if (v >= 0) {
                def lv:int (itemAt vLayer v)
                if ((itemAt counts lv) == 0) {
                    set_at starts lv s
                }
                set_at counts lv ((itemAt counts lv) + 1)
            }
            s = (s + 1)
        }
        def pass:int 0
        while (pass < balanceSweeps) {
            def down:boolean ((pass % 2) == 0)
            if down {
                def d:int 1
                while (d < lc) {
                    this.balanceLayer(seq (itemAt starts d) (itemAt counts d) true)
                    d = (d + 1)
                }
            } {
                def u:int (lc - 2)
                while (u >= 0) {
                    this.balanceLayer(seq (itemAt starts u) (itemAt counts u) false)
                    u = (u - 1)
                }
            }
            pass = (pass + 1)
        }
        ; Back to the origin: the fit is free to drift, the page is not.
        def low:double 0.0
        def first:boolean true
        def v2:int 0
        while (v2 < (this.vertexCount())) {
            def edge:double ((itemAt vCross v2) - ((itemAt vExtent v2) * 0.5))
            if first {
                low = edge
                first = false
            }
            if (edge < low) {
                low = edge
            }
            v2 = (v2 + 1)
        }
        def v3:int 0
        while (v3 < (this.vertexCount())) {
            def at:double ((itemAt vCross v3) - low)
            set_at vCross v3 at
            def ni:int (itemAt vNode v3)
            if (ni >= 0) {
                def nd:FlowNode (graph.nodeAt(ni))
                def corner:double (at - ((itemAt vExtent v3) * 0.5))
                if (direction == "TB") {
                    nd.x = (originX + corner)
                } {
                    nd.y = (originY + corner)
                }
                nd.syncFromModel()
            }
            v3 = (v3 + 1)
        }
    }

    ; Where edge `k` attaches to the node vertex `v` stands for, from the
    ; node's middle along the cross axis. Zero for a dummy, for an edge
    ; nobody said anything about, and for the middle.
    fn attachOffset:double (v:int k:int) {
        if (k < 0) {
            return 0.0
        }
        def ni:int (itemAt vNode v)
        if (ni < 0) {
            return 0.0
        }
        if (k >= (array_length edgeOffsetSource)) {
            return 0.0
        }
        if (k >= (array_length edgeOffsetTarget)) {
            return 0.0
        }
        def ed:FlowEdge (graph.edgeAt(k))
        if (ed.sourceIndex == ni) {
            return (itemAt edgeOffsetSource k)
        }
        return (itemAt edgeOffsetTarget k)
    }

    ; Whether edge `k` may meet the node vertex `v` stands for anywhere.
    fn looseEnd:boolean (v:int k:int) {
        if (k < 0) {
            return false
        }
        def ni:int (itemAt vNode v)
        if (ni < 0) {
            return false
        }
        if (k >= (array_length edgeLooseSource)) {
            return false
        }
        if (k >= (array_length edgeLooseTarget)) {
            return false
        }
        def ed:FlowEdge (graph.edgeAt(k))
        if (ed.sourceIndex == ni) {
            return (itemAt edgeLooseSource k)
        }
        return (itemAt edgeLooseTarget k)
    }

    fn balanceLayer:void (seq:[int] start:int count:int useIncoming:boolean) {
        if (count == 0) {
            return
        }
        ; What each vertex wants, how much it wants it, and how far apart
        ; the layer's order keeps it from the one before.
        def want:[double]
        def weight:[double]
        def offset:[double]
        def acc:double 0.0
        def k:int 0
        while (k < count) {
            def v:int (itemAt seq (start + k))
            def total:double 0.0
            def n:int 0
            def realTotal:double 0.0
            def realN:int 0
            def backTotal:double 0.0
            def backN:int 0
            def at:int -1
            if useIncoming {
                at = (itemAt vInHead v)
            } {
                at = (itemAt vOutHead v)
            }
            def isDummy:boolean ((itemAt vNode v) < 0)
            ; The end of a long edge: a dummy next to the node its edge
            ; leaves or arrives at. It asks for that node's middle, as the
            ; box next door does, so the two share the room under the node
            ; evenly — one to each side — and the node, counting both,
            ; stands over the middle of them. With slack instead (anywhere
            ; over the node would do) the box took the middle and the lane
            ; was left hanging off one side. Groups keep their slack: a
            ; line may land anywhere on a frame (`edgeLooseSource`).
            def endOfEdge:boolean false
            def offsets:boolean ((array_length edgeOffsetSource) > 0)
            while (at >= 0) {
                def other:int 0
                def via:int -1
                if useIncoming {
                    other = (itemAt vInFrom at)
                    via = (itemAt vInEdge at)
                    at = (itemAt vInNext at)
                } {
                    other = (itemAt vOutTo at)
                    via = (itemAt vOutEdge at)
                    at = (itemAt vOutNext at)
                }
                def oc:double (itemAt vCross other)
                def mine:double (this.attachOffset(v via))
                if ((itemAt vNode other) >= 0) {
                    def attach:double (oc + (this.attachOffset(other via)))
                    if isDummy {
                        if (this.verticalFlow()) {
                            if (this.reversedDummy(v)) {
                                ; A return lane stays where it was packed —
                                ; on the left, clear of the column it is
                                ; avoiding. Sliding it under the end box
                                ; (the endOfEdge slack) put it on top of
                                ; that column again.
                                oc = (itemAt vCross v)
                            } {
                                def here:double (itemAt vCross v)
                                def reach:double (((itemAt vExtent other) * 0.5) + nodeGap)
                                if offsets {
                                    if ((this.looseEnd(other via)) == false) {
                                        reach = nodeGap
                                    }
                                }
                                if (offsets == false) {
                                    reach = 0.0
                                }
                                if (here < (attach - reach)) { here = (attach - reach) }
                                if (here > (attach + reach)) { here = (attach + reach) }
                                oc = here
                                endOfEdge = true
                            }
                        } {
                            def here2:double (itemAt vCross v)
                            def reach2:double (((itemAt vExtent other) * 0.5) + nodeGap)
                            if offsets {
                                if ((this.looseEnd(other via)) == false) {
                                    reach2 = nodeGap
                                }
                            }
                            ; a way back keeps its slack: it is the
                            ; loop's return, not one of two ways on
                            if ((offsets == false) && ((this.reversedDummy(v)) == false)) {
                                reach2 = 0.0
                            }
                            if (here2 < (attach - reach2)) { here2 = (attach - reach2) }
                            if (here2 > (attach + reach2)) { here2 = (attach + reach2) }
                            oc = here2
                            endOfEdge = true
                        }
                    } {
                        oc = (attach - mine)
                    }
                    realTotal = (realTotal + oc)
                    realN = (realN + 1)
                } {
                    if (isDummy == false) {
                        oc = (oc - mine)
                        ; A long edge of this node's own, forwards: one of
                        ; its ways out (or in) as much as a box next door
                        ; is. Counted with them, a fork into a box and a
                        ; skip past that box stands over the middle of the
                        ; two, and the two lines leave it symmetrically,
                        ; one to each side, rather than one straight down
                        ; and the other bent round the box it skips.
                        if (this.reversedDummy(other) == false) {
                            realTotal = (realTotal + oc)
                            realN = (realN + 1)
                        }
                        ; A return path ends here: count it with the real
                        ; neighbours so the node sits on that side rather
                        ; than on the parent and leaving the path to go
                        ; around the far side of the column. TB/BT only —
                        ; an LR row of states is not this picture.
                        if (this.verticalFlow()) {
                            if (this.reversedDummy(other)) {
                                ; Only the node the return BEGINS at sits
                                ; on that column. Counting the dummy for
                                ; the node it arrives at pulled that node
                                ; off the chain and bent the edges that
                                ; were already straight.
                                def ev:int (itemAt vEdge other)
                                def ed:FlowEdge (graph.edgeAt(ev))
                                if (ed.sourceIndex == (itemAt vNode v)) {
                                    backTotal = (backTotal + oc)
                                    backN = (backN + 1)
                                    realTotal = (realTotal + oc)
                                    realN = (realN + 1)
                                }
                            }
                        }
                    }
                }
                total = (total + oc)
                n = (n + 1)
            }
            if (isDummy == false) {
                if (backN > 0) {
                    total = backTotal
                    n = backN
                } {
                    if (realN > 0) {
                        total = realTotal
                        n = realN
                    }
                }
            }
            if (n == 0) {
                push want (itemAt vCross v)
                push weight 0.2
            } {
                push want (total / (to_double n))
                def w:double (to_double n)
                if isDummy {
                    w = dummyWeight
                    if endOfEdge {
                        w = (dummyWeight * 0.25)
                    }
                }
                push weight w
            }
            if (k > 0) {
                def prev:int (itemAt seq ((start + k) - 1))
                ; A node keeps `nodeGap` from a node. A long edge going by
                ; needs less: a lane's width from the next lane, and half a
                ; gap from a box, which is more than the router keeps.
                def apart:double nodeGap
                def prevDummy:boolean ((itemAt vNode prev) < 0)
                if prevDummy {
                    apart = (nodeGap * 0.5)
                } {
                    if isDummy {
                        apart = (nodeGap * 0.5)
                    }
                }
                if prevDummy {
                    if isDummy {
                        apart = edgeGap
                    }
                }
                ; A return column is a column: keep a full node gap from
                ; the boxes it is avoiding, so freely placed children of
                ; those boxes can hang on the open side rather than step
                ; over the return. Dummy-to-dummy stays a lane's width.
                if (this.verticalFlow()) {
                    def backLane:boolean false
                    if prevDummy {
                        if (this.reversedDummy(prev)) {
                            backLane = true
                        }
                    }
                    if isDummy {
                        if (this.reversedDummy(v)) {
                            backLane = true
                        }
                    }
                    if backLane {
                        if prevDummy {
                            if isDummy {
                                apart = edgeGap
                            } {
                                apart = nodeGap
                            }
                        } {
                            apart = nodeGap
                        }
                    }
                }
                def gap:double ((((itemAt vExtent prev) + (itemAt vExtent v)) * 0.5) + apart)
                acc = (acc + gap)
            }
            push offset acc
            k = (k + 1)
        }
        ; Pool adjacent violators over the positions with the gaps taken
        ; out, so the constraint is simply "no block behind the one before".
        def blockW:[double]
        def blockWT:[double]
        def blockEnd:[int]
        def i:int 0
        while (i < count) {
            def w2:double (itemAt weight i)
            def t:double ((itemAt want i) - (itemAt offset i))
            push blockW w2
            push blockWT (w2 * t)
            push blockEnd i
            def merging:boolean true
            while merging {
                def nb:int (array_length blockW)
                if (nb < 2) {
                    merging = false
                } {
                    def lastW:double (itemAt blockW (nb - 1))
                    def lastWT:double (itemAt blockWT (nb - 1))
                    def prevW:double (itemAt blockW (nb - 2))
                    def prevWT:double (itemAt blockWT (nb - 2))
                    if ((lastWT / lastW) < (prevWT / prevW)) {
                        set_at blockW (nb - 2) (prevW + lastW)
                        set_at blockWT (nb - 2) (prevWT + lastWT)
                        set_at blockEnd (nb - 2) (itemAt blockEnd (nb - 1))
                        removeLast blockW
                        removeLast blockWT
                        removeLast blockEnd
                    } {
                        merging = false
                    }
                }
            }
            i = (i + 1)
        }
        def b:int 0
        def from:int 0
        while (b < (array_length blockEnd)) {
            def mean:double ((itemAt blockWT b) / (itemAt blockW b))
            def to:int (itemAt blockEnd b)
            def j:int from
            while (j <= to) {
                def v4:int (itemAt seq (start + j))
                set_at vCross v4 (mean + (itemAt offset j))
                j = (j + 1)
            }
            from = (to + 1)
            b = (b + 1)
        }
    }

    ; A stable global sequence: layer first, order within the layer second.
    ; One counting pass and one placement pass, both linear.
    fn vertexRanking:[int] () {
        def lc:int (this.layerCount())
        def n:int (this.vertexCount())
        def counts:[int]
        def i:int 0
        while (i < lc) {
            push counts 0
            i = (i + 1)
        }
        def v:int 0
        while (v < n) {
            def l:int (itemAt vLayer v)
            set_at counts l ((itemAt counts l) + 1)
            v = (v + 1)
        }
        def base:[int]
        def acc:int 0
        def k:int 0
        while (k < lc) {
            push base acc
            acc = (acc + (itemAt counts k))
            k = (k + 1)
        }
        def out:[int]
        def j:int 0
        while (j < n) {
            push out -1
            j = (j + 1)
        }
        def u:int 0
        while (u < n) {
            def lu:int (itemAt vLayer u)
            def slot:int ((itemAt base lu) + (itemAt vOrder u))
            if (slot < 0) {
                slot = 0
            }
            ; A duplicate order would silently drop a vertex from the layout,
            ; and a vertex that is never placed is a node drawn on top of
            ; another one. Take the next free slot instead of losing it.
            while (slot < n) {
                if ((itemAt out slot) < 0) {
                    break
                }
                slot = (slot + 1)
            }
            if (slot < n) {
                set_at out slot u
            }
            u = (u + 1)
        }
        return out
    }

    ; ------------------------------------------------------------ routing --
    ; The chains, cashed in. Each dummy contributed a position in the layer it
    ; stood in; those become the corners the edge is drawn through, so it goes
    ; AROUND what the ordering moved aside rather than over it.
    ;
    ; Call this after the handles have been settled — `SchemaToGraph.faceEdges`
    ; and friends decide which side of a table an edge leaves from, and the
    ; corners have to start where the edge actually starts.
    fn routeLongEdges:int () {
        def routed:int 0
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            clear e.waypoints
            def head:int -1
            if (k < (array_length chainHead)) {
                head = (itemAt chainHead k)
            }
            if (head >= 0) {
                if (this.emitRoute(k e)) {
                    routed = (routed + 1)
                }
            }
            k = (k + 1)
        }
        ; Then, with every route on the page, the brackets: each tried
        ; against the routes as they now stand, and kept only where it
        ; crosses no more of them than the route it replaces.
        def b:int 0
        while (b < (graph.edgeCount())) {
            if ((b < (array_length chainHead)) && ((itemAt chainHead b) >= 0)) {
                def eb:FlowEdge (graph.edgeAt(b))
                if ((array_length eb.waypoints) >= 4) {
                    def chainB:[int] (this.chainOf(b))
                    this.emitBracket(b eb (this.straightenedLanes(chainB)))
                }
            }
            b = (b + 1)
        }
        return routed
    }

    fn emitRoute:boolean (edgeIdx:int e:FlowEdge) {
        ; The chain was built in layer order; the edge is drawn in the author's
        ; order. When the layering reversed it to break a cycle those are
        ; opposite, and the corners have to come out the way round the arrow
        ; goes or the marker lands at the wrong end.
        def chain:[int] (this.chainOf(edgeIdx))
        def count:int (array_length chain)
        if (count == 0) {
            return false
        }
        def flip:boolean (itemAt edgeReversed edgeIdx)
        ; The lane each dummy was given, with a wobble taken out: two
        ; layers of different widths centre differently, so a chain's lane
        ; could move four pixels between one layer and the next, and the
        ; route got two corners for a jog nobody could see the reason for.
        ; A run of dummies whose lanes are within half a lane's room of each
        ; other is drawn down one lane, their mean, which is still inside
        ; the room every one of them was given.
        def lanes:[double] (this.straightenedLanes(chain))
        ; Which side to leave from, before asking where the endpoints are.
        ; `faceNeighbours` points every source the way the layout runs, which
        ; is right for an edge going forwards and wrong for one going back: a
        ; back edge left the node's right-hand side and immediately doubled
        ; across itself to reach a corridor on its left. A port, where there is
        ; one, still wins — the domain knows better than the layout which side
        ; of a table a foreign key belongs on.
        this.faceAlongRoute(e (itemAt chain 0) (itemAt chain ((array_length chain) - 1)) flip)
        def x1:double (graph.endpointX(e true))
        def y1:double (graph.endpointY(e true))
        def x2:double (graph.endpointX(e false))
        def y2:double (graph.endpointY(e false))
        def horizontal:boolean true
        if (direction == "TB") {
            horizontal = false
        }
        ; the corridor before each dummy's layer, and the one after the last
        def pts:[double]
        push pts x1
        push pts y1
        ; Where the route leaves the last corridor, kept so the final leg can
        ; be made to arrive straight.
        def lastLeave:double 0.0
        def i:int 0
        while (i < count) {
            def idx:int i
            if flip {
                idx = ((count - 1) - i)
            }
            def dv:int (itemAt chain idx)
            def lane:double (itemAt lanes idx)
            ; Enter the layer on the side the edge is coming from and leave on
            ; the other. Pushing them in layer order regardless meant a back
            ; edge crossed each layer the wrong way round: the corner list
            ; zig-zagged and its first point sat to the left of the node it was
            ; supposed to start at, so the route began in mid-air.
            def enter:double (this.corridorBefore((itemAt vLayer dv)))
            def leave:double (this.corridorAfter((itemAt vLayer dv)))
            if flip {
                enter = (this.corridorAfter((itemAt vLayer dv)))
                leave = (this.corridorBefore((itemAt vLayer dv)))
            }
            if horizontal {
                push pts enter
                push pts lane
                push pts leave
                push pts lane
            } {
                push pts lane
                push pts enter
                push pts lane
                push pts leave
            }
            lastLeave = leave
            i = (i + 1)
        }
        ; The last corner is turned short of the node, not on it.
        ; `orthogonalise` resolves a diagonal by going along the flow first,
        ; which is right for leaving — down out of the port, then across to
        ; the lane — and wrong for arriving: down the lane to the level of
        ; the port, then across to it, is a line drawn along the node's top
        ; edge with the arrow pointing sideways at a handle that faces up.
        ; So the route is sent to the port's stub point — the same twenty
        ; pixels out that every stepped edge turns at — and arrives from
        ; there straight in. The corridor's centre is not used for that last
        ; turn because the centre is where the short edges keep their tracks.
        def s2:int (graph.edgeSide(e false))
        push pts (x2 + ((FlowPosition.normalX(s2)) * 20.0))
        push pts (y2 + ((FlowPosition.normalY(s2)) * 20.0))
        push pts x2
        push pts y2
        def corners:[double] (LayeredLayout.orthogonalise(pts horizontal))
        def n:int (idiv (array_length corners) 2)
        if (n < 3) {
            return false
        }
        def w:int 0
        while (w < (array_length corners)) {
            push e.waypoints (itemAt corners w)
            w = (w + 1)
        }
        ; Lanes and waypoints are two answers to the same question, and the
        ; waypoints are the better-informed one.
        e.hasLaneX = false
        e.hasLaneY = false
        return true
    }

    ; A long edge whose lane is one straight run, beside both of its ends
    ; on the same side — a skip past the next box in a column, a return up
    ; it — is drawn as a bracket: out of the flank that faces the lane,
    ; along the lane, into the same flank of the other end. Two corners. The
    ; general route leaves along the flow and turns into the lane and out of
    ; it again: four corners, and ends that leave and arrive a box's width
    ; from where the line then runs. Only when the two short legs across
    ; are clear of every other box.
    fn emitBracket:boolean (edgeIdx:int e:FlowEdge lanes:[double]) {
        def n:int (array_length lanes)
        if (n == 0) {
            return false
        }
        ; a named port says which side, and that is not this layout's call
        if ((graph.hasPort(e.sourcePort)) || (graph.hasPort(e.targetPort))) {
            return false
        }
        def lane:double (itemAt lanes 0)
        def i:int 1
        while (i < n) {
            if ((fabs ((itemAt lanes i) - lane)) > 0.5) {
                return false
            }
            i = (i + 1)
        }
        if (e.sourceIndex < 0) {
            return false
        }
        if (e.targetIndex < 0) {
            return false
        }
        def s:FlowNode (graph.nodeAt(e.sourceIndex))
        def t:FlowNode (graph.nodeAt(e.targetIndex))
        ; a flank the end can slide along: a circle's or a diamond's border
        ; moves sideways as the socket moves up it
        if (((LayeredLayout.flatFlanks(s.shape)) && (LayeredLayout.flatFlanks(t.shape))) == false) {
            return false
        }
        def vertical:boolean (direction == "TB")
        def sLo:double s.y
        def sHi:double (s.y + s.height)
        def tLo:double t.y
        def tHi:double (t.y + t.height)
        if vertical {
            sLo = s.x
            sHi = (s.x + s.width)
            tLo = t.x
            tHi = (t.x + t.width)
        }
        def room:double 8.0
        def side:int -1
        if ((lane > (sHi + room)) && (lane > (tHi + room))) {
            side = 1
            if (vertical == false) {
                side = 2
            }
        }
        if ((lane < (sLo - room)) && (lane < (tLo - room))) {
            side = 3
            if (vertical == false) {
                side = 0
            }
        }
        if (side < 0) {
            return false
        }
        def oldS:int e.sourceHandle
        def oldT:int e.targetHandle
        e.sourceHandle = side
        e.targetHandle = side
        def x1:double (graph.endpointX(e true))
        def y1:double (graph.endpointY(e true))
        def x2:double (graph.endpointX(e false))
        def y2:double (graph.endpointY(e false))
        def pts:[double]
        push pts x1
        push pts y1
        if vertical {
            push pts lane
            push pts y1
            push pts lane
            push pts y2
        } {
            push pts x1
            push pts lane
            push pts x2
            push pts lane
        }
        push pts x2
        push pts y2
        def k:int 0
        while (k < (graph.nodeCount())) {
            if ((k != e.sourceIndex) && (k != e.targetIndex)) {
                def o:FlowNode (graph.nodeAt(k))
                if (o.hidden == false) {
                    def q:int 2
                    while (q < (array_length pts)) {
                        if (LayeredLayout.legHits(o (itemAt pts (q - 2)) (itemAt pts (q - 1)) (itemAt pts q) (itemAt pts (q + 1)))) {
                            e.sourceHandle = oldS
                            e.targetHandle = oldT
                            return false
                        }
                        q = (q + 2)
                    }
                }
            }
            k = (k + 1)
        }
        ; no more crossings than the route it would replace
        e.sourceHandle = oldS
        e.targetHandle = oldT
        def oldCorners:[double] (EdgeRouter.cornersFor(graph e))
        e.sourceHandle = side
        e.targetHandle = side
        if ((this.crossingsWith(edgeIdx pts)) > (this.crossingsWith(edgeIdx oldCorners))) {
            e.sourceHandle = oldS
            e.targetHandle = oldT
            return false
        }
        clear e.waypoints
        def w:int 0
        while (w < (array_length pts)) {
            push e.waypoints (itemAt pts w)
            w = (w + 1)
        }
        e.hasLaneX = false
        e.hasLaneY = false
        return true
    }

    ; How many times a corner list crosses the other edges as drawn now.
    fn crossingsWith:int (skipIdx:int pts:[double]) {
        def total:int 0
        def k:int 0
        while (k < (graph.edgeCount())) {
            if (k != skipIdx) {
                def o:FlowEdge (graph.edgeAt(k))
                if ((o.hidden == false) && ((o.sourceIndex >= 0) && (o.targetIndex >= 0))) {
                    def c:[double] (EdgeRouter.cornersFor(graph o))
                    def i:int 2
                    while (i < (array_length c)) {
                        def j:int 2
                        while (j < (array_length pts)) {
                            if (LayeredLayout.segmentsCross((itemAt pts (j - 2)) (itemAt pts (j - 1)) (itemAt pts j) (itemAt pts (j + 1)) (itemAt c (i - 2)) (itemAt c (i - 1)) (itemAt c i) (itemAt c (i + 1)))) {
                                total = (total + 1)
                            }
                            j = (j + 2)
                        }
                        i = (i + 2)
                    }
                }
            }
            k = (k + 1)
        }
        return total
    }

    ; Two segments crossing properly — touching at an end does not count.
    sfn segmentsCross:boolean (ax:double ay:double bx:double by:double cx:double cy:double dx:double dy:double) {
        def d1:double (((bx - ax) * (cy - ay)) - ((by - ay) * (cx - ax)))
        def d2:double (((bx - ax) * (dy - ay)) - ((by - ay) * (dx - ax)))
        def d3:double (((dx - cx) * (ay - cy)) - ((dy - cy) * (ax - cx)))
        def d4:double (((dx - cx) * (by - cy)) - ((dy - cy) * (bx - cx)))
        if (((d1 * d2) < 0.0) && ((d3 * d4) < 0.0)) {
            return true
        }
        return false
    }

    sfn flatFlanks:boolean (shape:string) {
        if (shape == "rect") { return true }
        if (shape == "roundrect") { return true }
        if (shape == "action") { return true }
        if (shape == "subroutine") { return true }
        return false
    }

    ; Whether an axis-aligned leg comes within a few pixels of a box.
    sfn legHits:boolean (o:FlowNode x1:double y1:double x2:double y2:double) {
        def pad:double 4.0
        def lx:double x1
        def hx:double x2
        if (x2 < x1) {
            lx = x2
            hx = x1
        }
        def ly:double y1
        def hy:double y2
        if (y2 < y1) {
            ly = y2
            hy = y1
        }
        if (hx < (o.x - pad)) { return false }
        if (lx > ((o.x + o.width) + pad)) { return false }
        if (hy < (o.y - pad)) { return false }
        if (ly > ((o.y + o.height) + pad)) { return false }
        return true
    }

    fn straightenedLanes:[double] (chain:[int]) {
        def out:[double]
        def n:int (array_length chain)
        def near:double (edgeGap * 0.5)
        def i:int 0
        while (i < n) {
            ; The run starting here: every following dummy whose lane is
            ; within `near` of this one's.
            def first:double (itemAt vCross (itemAt chain i))
            def sum:double 0.0
            def count:int 0
            def j:int i
            def going:boolean true
            while (j < n) {
                if going {
                    def lane:double (itemAt vCross (itemAt chain j))
                    if ((fabs (lane - first)) <= near) {
                        sum = (sum + lane)
                        count = (count + 1)
                        j = (j + 1)
                    } {
                        going = false
                    }
                } {
                    j = n
                }
            }
            def mean:double (sum / (to_double count))
            def k:int 0
            while (k < count) {
                push out mean
                k = (k + 1)
            }
            i = (i + count)
        }
        return out
    }

    ; Point each end at the corridor it actually meets.
    fn faceAlongRoute:void (e:FlowEdge firstDummy:int lastDummy:int flip:boolean) {
        def entry:int firstDummy
        def exit:int lastDummy
        if flip {
            entry = lastDummy
            exit = firstDummy
        }
        def toSource:double (this.corridorBefore((itemAt vLayer entry)))
        def fromTarget:double (this.corridorAfter((itemAt vLayer exit)))
        if flip {
            toSource = (this.corridorAfter((itemAt vLayer entry)))
            fromTarget = (this.corridorBefore((itemAt vLayer exit)))
        }
        def s:FlowNode (graph.nodeById(e.source))
        def t:FlowNode (graph.nodeById(e.target))
        if (direction == "TB") {
            e.sourceHandle = (LayeredLayout.faceTo((s.centerY()) toSource 0 2))
            e.targetHandle = (LayeredLayout.faceTo((t.centerY()) fromTarget 0 2))
            return
        }
        e.sourceHandle = (LayeredLayout.faceTo((s.centerX()) toSource 3 1))
        e.targetHandle = (LayeredLayout.faceTo((t.centerX()) fromTarget 3 1))
    }

    sfn faceTo:int (centre:double toward:double lowSide:int highSide:int) {
        if (toward < centre) {
            return lowSide
        }
        return highSide
    }

    fn chainOf:[int] (edgeIdx:int) {
        def out:[int]
        def v:int 0
        while (v < (this.vertexCount())) {
            if ((itemAt vNode v) < 0) {
                if ((itemAt vEdge v) == edgeIdx) {
                    push out v
                }
            }
            v = (v + 1)
        }
        ; built in ascending layer order already, because the chain was pushed
        ; that way and vertices keep their creation order
        return out
    }

    ; Arithmetic on a call result needs the call bound first, so `base` is not
    ; a stylistic choice.
    fn corridorBefore:double (layer:int) {
        def base:double (this.originOf())
        if (layer <= 0) {
            def firstAt:double (itemAt layerMain 0)
            return (base + firstAt)
        }
        def prevEnd:double ((itemAt layerMain (layer - 1)) + (itemAt layerDepth (layer - 1)))
        def here:double (itemAt layerMain layer)
        def mid:double ((prevEnd + here) * 0.5)
        return (base + mid)
    }

    fn corridorAfter:double (layer:int) {
        def base:double (this.originOf())
        def lc:int (this.layerCount())
        if (layer >= (lc - 1)) {
            def end:double ((itemAt layerMain layer) + (itemAt layerDepth layer))
            return (base + end)
        }
        def hereEnd:double ((itemAt layerMain layer) + (itemAt layerDepth layer))
        def next:double (itemAt layerMain (layer + 1))
        def mid2:double ((hereEnd + next) * 0.5)
        return (base + mid2)
    }

    fn originOf:double () {
        if (direction == "TB") {
            return originY
        }
        return originX
    }

    ; The points above are a mix of real endpoints and lane crossings; this
    ; turns them into a strictly orthogonal corner list by inserting the corner
    ; each diagonal implies, and drops the ones that do not turn.
    sfn orthogonalise:[double] (pts:[double] horizontal:boolean) {
        def out:[double]
        def n:int (idiv (array_length pts) 2)
        if (n == 0) {
            return out
        }
        def cx:double (itemAt pts 0)
        def cy:double (itemAt pts 1)
        push out cx
        push out cy
        def i:int 1
        while (i < n) {
            def x:double (itemAt pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt pts yat)
            def dx:double (fabs (x - cx))
            def dy:double (fabs (y - cy))
            if (dx > 0.01) {
                if (dy > 0.01) {
                    ; a diagonal: go along the main axis first, which is the
                    ; direction the layout runs in
                    if horizontal {
                        push out x
                        push out cy
                    } {
                        push out cx
                        push out y
                    }
                }
            }
            push out x
            push out y
            cx = x
            cy = y
            i = (i + 1)
        }
        return (EdgeRouter.dropCollinear(out))
    }


    ; Point each node's default handles the way the layout runs, so an edge
    ; leaves the side that faces where it is going.
    fn faceNeighbours:void () {
        def i:int 0
        while (i < (graph.nodeCount())) {
            def n:FlowNode (graph.nodeAt(i))
            if (direction == "TB") {
                n.sourcePosition = 2
                n.targetPosition = 0
            } {
                n.sourcePosition = 1
                n.targetPosition = 3
            }
            i = (i + 1)
        }
    }
}
