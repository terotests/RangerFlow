; ============================================================================
; XsJson.rgr — the machine config as a tree, read as XState writers write it.
; ============================================================================
;
; An XState machine arrives in three spellings: strict JSON (what a store
; keeps), the object literal inside `createMachine({ … })` with bare keys and
; single quotes (what Stately's editor exports and what people paste), and
; that literal wrapped in `setup({ … }).createMachine(…)` or followed by
; `.withConfig(…)`. This reads all three into one tree:
;
;   createMachine({ id: 'door', initial: "shut", })     ← JS literal
;   { "id": "door", "initial": "shut" }                 ← JSON
;                       │
;                       ▼
;                XsJson object  (keys kept in the order written)
;
; Only the CONFIG object is read: the argument of `createMachine(…)` when the
; text has one, the first `{ … }` otherwise. The functions in `setup` and
; `withConfig` are implementations of guards and actions, which in Sliqtly
; belong to the host, never to the document — so they are not read at all.
; A function INSIDE the config (an inline guard) is a value this cannot hold,
; and it says so with the line, rather than reading half a machine.
;
; Accepted beyond JSON: `//` and `/* */` comments, bare keys, single-quoted
; strings, trailing commas, and `undefined` (read as null).
;
; The tree also writes itself back (`write`), two-space indented, which is
; what an edit made in a window turns the fence text into.
; ============================================================================

class XsJson {
    ; "null" | "bool" | "number" | "string" | "array" | "object"
    def kind:string "null"
    def str:string ""
    def num:double 0.0
    ; the number as written, so 1000 stays 1000 rather than 1000.0
    def numText:string ""
    def flag:boolean false
    def items:[XsJson]
    def keys:[string]
    def values:[XsJson]

    Constructor () {
    }

    sfn text:XsJson (s:string) {
        def v (new XsJson)
        v.kind = "string"
        v.str = s
        return v
    }

    sfn object:XsJson () {
        def v (new XsJson)
        v.kind = "object"
        return v
    }

    sfn array:XsJson () {
        def v (new XsJson)
        v.kind = "array"
        return v
    }

    sfn boolean:XsJson (b:boolean) {
        def v (new XsJson)
        v.kind = "bool"
        v.flag = b
        return v
    }

    fn isObject:boolean () {
        return (kind == "object")
    }

    fn isArray:boolean () {
        return (kind == "array")
    }

    fn isString:boolean () {
        return (kind == "string")
    }

    fn count:int () {
        if (kind == "array") {
            return (array_length items)
        }
        return (array_length keys)
    }

    fn at:XsJson (i:int) {
        return (itemAt items i)
    }

    fn keyAt:string (i:int) {
        return (itemAt keys i)
    }

    fn valueAt:XsJson (i:int) {
        return (itemAt values i)
    }

    fn indexOfKey:int (key:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn has:boolean (key:string) {
        return ((this.indexOfKey(key)) >= 0)
    }

    ; The member, or a null value when there is none.
    fn get:XsJson (key:string) {
        def at:int (this.indexOfKey(key))
        if (at < 0) {
            return (new XsJson)
        }
        return (itemAt values at)
    }

    fn stringOr:string (key:string dflt:string) {
        def at:int (this.indexOfKey(key))
        if (at < 0) {
            return dflt
        }
        def v:XsJson (itemAt values at)
        if (v.kind == "string") {
            return v.str
        }
        if (v.kind == "number") {
            return v.numText
        }
        return dflt
    }

    fn boolOr:boolean (key:string dflt:boolean) {
        def at:int (this.indexOfKey(key))
        if (at < 0) {
            return dflt
        }
        def v:XsJson (itemAt values at)
        if (v.kind == "bool") {
            return v.flag
        }
        return dflt
    }

    ; Set a member, in its place when it is there and at the end when not.
    fn set:void (key:string value:XsJson) {
        def at:int (this.indexOfKey(key))
        if (at >= 0) {
            set_at values at value
            return
        }
        push keys key
        push values value
    }

    ; Set a member, placed after `after` when it is new (the order a reader
    ; expects: `initial` near the top, `on` before `states`).
    fn setAfter:void (key:string value:XsJson after:string) {
        def at:int (this.indexOfKey(key))
        if (at >= 0) {
            set_at values at value
            return
        }
        def where:int (this.indexOfKey(after))
        if (where < 0) {
            this.set(key value)
            return
        }
        def nk:[string]
        def nv:[XsJson]
        def i:int 0
        while (i < (array_length keys)) {
            push nk (itemAt keys i)
            push nv (itemAt values i)
            if (i == where) {
                push nk key
                push nv value
            }
            i = (i + 1)
        }
        keys = nk
        values = nv
    }

    fn remove:void (key:string) {
        def at:int (this.indexOfKey(key))
        if (at < 0) {
            return
        }
        remove_index keys at
        remove_index values at
    }

    ; Rename a member in its place, keeping its value.
    fn renameKey:void (from:string to:string) {
        def at:int (this.indexOfKey(from))
        if (at < 0) {
            return
        }
        set_at keys at to
    }

    fn removeItem:void (i:int) {
        if ((i >= 0) && (i < (array_length items))) {
            remove_index items i
        }
    }

    ; --------------------------------------------------------------- write --
    sfn quote:string (s:string) {
        def out:string "\""
        def i:int 0
        def n:int (strlen s)
        def from:int 0
        while (i < n) {
            def c:int (charAt s i)
            def esc:string ""
            if (c == 34) { esc = "\\\"" }
            if (c == 92) { esc = "\\\\" }
            if (c == 10) { esc = "\\n" }
            if (c == 13) { esc = "\\r" }
            if (c == 9) { esc = "\\t" }
            if ((strlen esc) > 0) {
                out = (out + (substring s from i) + esc)
                from = (i + 1)
            }
            i = (i + 1)
        }
        return (out + (substring s from n) + "\"")
    }

    sfn pad:string (depth:int) {
        def out:string ""
        def i:int 0
        while (i < depth) {
            out = (out + "  ")
            i = (i + 1)
        }
        return out
    }

    ; Whether a value is short enough to sit on one line: no object or array
    ; inside it with anything in it.
    fn flat:boolean () {
        if ((kind != "object") && (kind != "array")) {
            return true
        }
        return ((this.count()) == 0)
    }

    ; An object of plain values (or lists of them) on one line, the way a
    ; transition is usually written: `{ "target": "b", "guard": "g" }`.
    ; Empty when something in it is an object or a nested list.
    fn oneLine:string () {
        def parts:[string]
        def m:int 0
        while (m < (array_length keys)) {
            def v:XsJson (itemAt values m)
            if ((v.kind == "object") && ((v.count()) > 0)) {
                return ""
            }
            if (v.kind == "array") {
                def k:int 0
                while (k < (array_length v.items)) {
                    def it:XsJson (itemAt v.items k)
                    if ((it.flat()) == false) {
                        return ""
                    }
                    k = (k + 1)
                }
            }
            push parts ((XsJson.quote((itemAt keys m))) + ": " + (v.write(0)))
            m = (m + 1)
        }
        return ("{ " + (join parts ", ") + " }")
    }

    ; The tree as JSON, two spaces a level. An array of plain values stays
    ; on one line (`["a", "b"]`), which is how actions lists read.
    fn write:string (depth:int) {
        if (kind == "string") {
            return (XsJson.quote(str))
        }
        if (kind == "number") {
            return numText
        }
        if (kind == "bool") {
            if flag {
                return "true"
            }
            return "false"
        }
        if (kind == "array") {
            if ((array_length items) == 0) {
                return "[]"
            }
            def allFlat:boolean true
            def i:int 0
            while (i < (array_length items)) {
                def it:XsJson (itemAt items i)
                if ((it.flat()) == false) {
                    allFlat = false
                }
                i = (i + 1)
            }
            if allFlat {
                def parts:[string]
                def k:int 0
                while (k < (array_length items)) {
                    def it2:XsJson (itemAt items k)
                    push parts (it2.write((depth + 1)))
                    k = (k + 1)
                }
                return ("[" + (join parts ", ") + "]")
            }
            def out:string "[\n"
            def j:int 0
            while (j < (array_length items)) {
                def it3:XsJson (itemAt items j)
                out = (out + (XsJson.pad((depth + 1))) + (it3.write((depth + 1))))
                if (j < ((array_length items) - 1)) {
                    out = (out + ",")
                }
                out = (out + "\n")
                j = (j + 1)
            }
            return (out + (XsJson.pad(depth)) + "]")
        }
        if (kind == "object") {
            if ((array_length keys) == 0) {
                return "{}"
            }
            def one:string (this.oneLine())
            if (((strlen one) > 0) && (((depth * 2) + (strlen one)) <= 72)) {
                return one
            }
            def out2:string "{\n"
            def m:int 0
            while (m < (array_length keys)) {
                def v:XsJson (itemAt values m)
                out2 = (out2 + (XsJson.pad((depth + 1))) + (XsJson.quote((itemAt keys m))) + ": " + (v.write((depth + 1))))
                if (m < ((array_length keys) - 1)) {
                    out2 = (out2 + ",")
                }
                out2 = (out2 + "\n")
                m = (m + 1)
            }
            return (out2 + (XsJson.pad(depth)) + "}")
        }
        return "null"
    }

    fn copy:XsJson () {
        def v (new XsJson)
        v.kind = kind
        v.str = str
        v.num = num
        v.numText = numText
        v.flag = flag
        def i:int 0
        while (i < (array_length items)) {
            def it:XsJson (itemAt items i)
            push v.items (it.copy())
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length keys)) {
            push v.keys (itemAt keys k)
            def mv:XsJson (itemAt values k)
            push v.values (mv.copy())
            k = (k + 1)
        }
        return v
    }
}

; ----------------------------------------------------------------------------
; The reader
; ----------------------------------------------------------------------------
class XsJsonReader {
    def s:string ""
    def i:int 0
    def n:int 0
    def error:string ""
    def errorAt:int -1

    Constructor () {
    }

    ; The line (1 = the first) an offset of the text is on.
    sfn lineOf:int (text:string at:int) {
        def line:int 1
        def k:int 0
        def stop:int at
        if (stop > (strlen text)) {
            stop = (strlen text)
        }
        while (k < stop) {
            if ((charAt text k) == 10) {
                line = (line + 1)
            }
            k = (k + 1)
        }
        return line
    }

    fn errorLine:int () {
        if (errorAt < 0) {
            return 0
        }
        return (XsJsonReader.lineOf(s errorAt))
    }

    fn fail:void (what:string) {
        if ((strlen error) > 0) {
            return
        }
        error = what
        errorAt = i
    }

    ; Where the config object starts: after `createMachine(` when the text
    ; calls it, else at the first `{` outside a comment or string.
    fn configStart:int () {
        def call:int (this.findCode("createMachine" 0))
        def from:int 0
        if (call >= 0) {
            from = (call + 13)
        }
        return (this.findCode("{" from))
    }

    ; The first `word` at or after `from` that is code: not in a string, not
    ; in a comment.
    fn findCode:int (word:string from:int) {
        def k:int from
        def wl:int (strlen word)
        while (k < n) {
            def c:int (charAt s k)
            if ((c == 34) || ((c == 39) || (c == 96))) {
                k = (this.skipQuoted(k))
                continue
            }
            if ((c == 47) && ((k + 1) < n)) {
                def d:int (charAt s (k + 1))
                if (d == 47) {
                    while ((k < n) && ((charAt s k) != 10)) {
                        k = (k + 1)
                    }
                    continue
                }
                if (d == 42) {
                    k = (k + 2)
                    while ((k + 1) < n) {
                        if (((charAt s k) == 42) && ((charAt s (k + 1)) == 47)) {
                            break
                        }
                        k = (k + 1)
                    }
                    k = (k + 2)
                    continue
                }
            }
            if (((k + wl) <= n) && ((substring s k (k + wl)) == word)) {
                return k
            }
            k = (k + 1)
        }
        return -1
    }

    ; The offset just past a quoted run that starts at `k`.
    fn skipQuoted:int (k:int) {
        def q:int (charAt s k)
        def j:int (k + 1)
        while (j < n) {
            def c:int (charAt s j)
            if (c == 92) {
                j = (j + 2)
                continue
            }
            if (c == q) {
                return (j + 1)
            }
            j = (j + 1)
        }
        return n
    }

    fn read:XsJson (text:string) {
        s = text
        n = (strlen text)
        error = ""
        errorAt = -1
        i = (this.configStart())
        if (i < 0) {
            i = 0
            this.fail("no { … } machine config in the text")
            return (new XsJson)
        }
        def v:XsJson (this.value())
        return v
    }

    fn skipSpace:void () {
        while (i < n) {
            def c:int (charAt s i)
            if ((c == 32) || ((c == 9) || ((c == 10) || (c == 13)))) {
                i = (i + 1)
                continue
            }
            if ((c == 47) && ((i + 1) < n)) {
                def d:int (charAt s (i + 1))
                if (d == 47) {
                    while ((i < n) && ((charAt s i) != 10)) {
                        i = (i + 1)
                    }
                    continue
                }
                if (d == 42) {
                    i = (i + 2)
                    while ((i + 1) < n) {
                        if (((charAt s i) == 42) && ((charAt s (i + 1)) == 47)) {
                            break
                        }
                        i = (i + 1)
                    }
                    i = (i + 2)
                    continue
                }
            }
            return
        }
    }

    sfn isIdent:boolean (c:int) {
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        if ((c == 95) || (c == 36)) { return true }
        return false
    }

    fn value:XsJson () {
        this.skipSpace()
        if (i >= n) {
            this.fail("the text ends before the value")
            return (new XsJson)
        }
        def c:int (charAt s i)
        if (c == 123) {
            return (this.object())
        }
        if (c == 91) {
            return (this.array())
        }
        if ((c == 34) || (c == 39)) {
            return (XsJson.text((this.quoted())))
        }
        if ((c == 45) || ((c >= 48) && (c <= 57))) {
            return (this.number())
        }
        def start:int i
        while ((i < n) && (XsJsonReader.isIdent((charAt s i)))) {
            i = (i + 1)
        }
        def word:string (substring s start i)
        if (word == "true") {
            return (XsJson.boolean(true))
        }
        if (word == "false") {
            return (XsJson.boolean(false))
        }
        if ((word == "null") || (word == "undefined")) {
            return (new XsJson)
        }
        i = start
        if ((word == "function") || (word == "async")) {
            this.fail("a function in the config: name the guard or action instead, e.g. \"guard\": \"canAccept\"")
            return (new XsJson)
        }
        if (c == 40) {
            this.fail("a function in the config: name the guard or action instead, e.g. \"guard\": \"canAccept\"")
            return (new XsJson)
        }
        if ((strlen word) > 0) {
            this.fail(("\"" + word + "\" is not a value: only JSON values are read (a name in quotes, a number, true, false, null, { }, [ ])"))
            return (new XsJson)
        }
        this.fail(("unexpected \"" + (substring s i (i + 1)) + "\""))
        return (new XsJson)
    }

    fn quoted:string () {
        def q:int (charAt s i)
        i = (i + 1)
        def out:string ""
        def from:int i
        while (i < n) {
            def c:int (charAt s i)
            if (c == q) {
                out = (out + (substring s from i))
                i = (i + 1)
                return out
            }
            if (c == 10) {
                this.fail("a string is not closed on its line")
                return out
            }
            if (c == 92) {
                out = (out + (substring s from i))
                if ((i + 1) < n) {
                    def e:int (charAt s (i + 1))
                    def put:string (substring s (i + 1) (i + 2))
                    if (e == 110) { put = "\n" }
                    if (e == 116) { put = "\t" }
                    if (e == 114) { put = "\r" }
                    if ((e == 117) && ((i + 5) < n)) {
                        def hex:string (substring s (i + 2) (i + 6))
                        put = (strfromcode (XsJsonReader.hexValue(hex)))
                        i = (i + 4)
                    }
                    out = (out + put)
                }
                i = (i + 2)
                from = i
                continue
            }
            i = (i + 1)
        }
        this.fail("a string is not closed")
        return out
    }

    sfn hexValue:int (hex:string) {
        def v:int 0
        def k:int 0
        while (k < (strlen hex)) {
            def c:int (charAt hex k)
            def d:int 0
            if ((c >= 48) && (c <= 57)) { d = (c - 48) }
            if ((c >= 97) && (c <= 102)) { d = (c - 87) }
            if ((c >= 65) && (c <= 70)) { d = (c - 55) }
            v = ((v * 16) + d)
            k = (k + 1)
        }
        return v
    }

    fn number:XsJson () {
        def start:int i
        i = (i + 1)
        while (i < n) {
            def c:int (charAt s i)
            if (((c >= 48) && (c <= 57)) || ((c == 46) || ((c == 101) || ((c == 69) || ((c == 43) || (c == 45)))))) {
                i = (i + 1)
            } {
                break
            }
        }
        def v (new XsJson)
        v.kind = "number"
        v.numText = (substring s start i)
        def d@(optional):double (str2double (trim v.numText))
        if (!null? d) {
            v.num = (unwrap d)
        }
        return v
    }

    fn key:string () {
        this.skipSpace()
        if (i >= n) {
            this.fail("the text ends inside an object")
            return ""
        }
        def c:int (charAt s i)
        if ((c == 34) || (c == 39)) {
            return (this.quoted())
        }
        def start:int i
        while ((i < n) && (XsJsonReader.isIdent((charAt s i)))) {
            i = (i + 1)
        }
        if (i == start) {
            this.fail(("a name was expected, found \"" + (substring s i (i + 1)) + "\""))
            return ""
        }
        return (substring s start i)
    }

    fn object:XsJson () {
        def v:XsJson (XsJson.object())
        i = (i + 1)
        while ((strlen error) == 0) {
            this.skipSpace()
            if (i >= n) {
                this.fail("an object is not closed with }")
                return v
            }
            if ((charAt s i) == 125) {
                i = (i + 1)
                return v
            }
            def k:string (this.key())
            if ((strlen error) > 0) {
                return v
            }
            this.skipSpace()
            if ((i < n) && ((charAt s i) == 40)) {
                this.fail(("\"" + k + "\" is a function: name the guard or action instead"))
                return v
            }
            if ((i >= n) || ((charAt s i) != 58)) {
                this.fail(("a : was expected after \"" + k + "\""))
                return v
            }
            i = (i + 1)
            def val:XsJson (this.value())
            push v.keys k
            push v.values val
            this.skipSpace()
            if ((i < n) && ((charAt s i) == 44)) {
                i = (i + 1)
                continue
            }
            if ((i < n) && ((charAt s i) == 125)) {
                continue
            }
            if ((strlen error) == 0) {
                this.fail(("a , or } was expected after \"" + k + "\""))
            }
        }
        return v
    }

    fn array:XsJson () {
        def v:XsJson (XsJson.array())
        i = (i + 1)
        while ((strlen error) == 0) {
            this.skipSpace()
            if (i >= n) {
                this.fail("a list is not closed with ]")
                return v
            }
            if ((charAt s i) == 93) {
                i = (i + 1)
                return v
            }
            push v.items (this.value())
            this.skipSpace()
            if ((i < n) && ((charAt s i) == 44)) {
                i = (i + 1)
                continue
            }
            if ((i < n) && ((charAt s i) == 93)) {
                continue
            }
            if ((strlen error) == 0) {
                this.fail("a , or ] was expected in a list")
            }
        }
        return v
    }
}
